---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Página não encontrada" noindex>
  <main class="relative flex flex-col justify-center gap-4 mx-auto px-8 max-w-xl min-h-screen">
    <span class="self-start eyebrow">Erro 404</span>
    <h1 class="h-section">Página não encontrada</h1>
    <p class="text-slate-400 text-lg">
      O endereço que você acessou não existe ou foi movido.
    </p>
    <a href={`${base}/`} class="self-start mt-4 btn-primary">
      Voltar para a página inicial
    </a>
  </main>
</Base>
