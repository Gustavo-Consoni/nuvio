---
/**
 * Página de links da Nuvio (o link da bio do Instagram), em "liquid glass".
 *
 * O vidro (`vidro-liquido`, no global.css) só aparece com cor atrás: do topo
 * ao rodapé há manchas paradas, alternando azul e roxo, separadas por uma
 * faixa escura, então o vidro passa de uma cor para o escuro e volta para a
 * outra. Com `prefers-reduced-motion` os botões entram sem animação.
 */
import Base from "../layouts/Base.astro";
import Rede from "../components/icons/Rede.astro";
import Seta from "../components/icons/Seta.astro";
import WhatsApp from "../components/icons/WhatsApp.astro";
import { site } from "../config";

const whatsapp = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent("Olá! Vim pelos links da Nuvio e quero um diagnóstico do meu negócio.")}`;

/** Traço dos ícones de linha (viewBox 24). */
const icones = {
  precos: "M7 7h.01M3 11.6V4a1 1 0 0 1 1-1h7.6a2 2 0 0 1 1.4.6l7.8 7.8a2 2 0 0 1 0 2.8l-6.6 6.6a2 2 0 0 1-2.8 0L3.6 13a2 2 0 0 1-.6-1.4z",
  exemplos: "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z",
  /** Símbolo de aproximação, o mesmo do MockupPecas. */
  toque: "M8.5 8.5a5 5 0 0 1 0 7M12 5.5a9.5 9.5 0 0 1 0 13M15.5 2.5a14 14 0 0 1 0 19",
  email: "M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5zM3.5 6l8.5 7 8.5-7",
};

const links = [
  { rotulo: "Diagnóstico gratuito", detalhe: "Pelo WhatsApp, sem compromisso", href: whatsapp, externo: true, icone: "whatsapp" },
  { rotulo: "Produtos e preços", detalhe: "Pagamento único, sem mensalidade", href: "/#produtos", externo: false, icone: icones.precos },
  { rotulo: "Teste o cartão", detalhe: "Veja o toque abrir o cardápio", href: "/#teste", externo: false, icone: icones.toque },
  { rotulo: "Exemplos", detalhe: "Sites, cardápios e linktrees para testar", href: "/#projetos", externo: false, icone: icones.exemplos },
  ...site.socials
    .filter((s) => s.href !== "#")
    .map((s) => ({
      rotulo: s.name,
      detalhe: `@${new URL(s.href).pathname.replaceAll("/", "")}`,
      href: s.href,
      externo: true,
      icone: s.name,
    })),
  { rotulo: "E-mail", detalhe: site.contact.email, href: `mailto:${site.contact.email}`, externo: false, icone: icones.email },
];

type NomeRede = (typeof site.socials)[number]["name"];
const ehRede = (icone: string): icone is NomeRede => site.socials.some((s) => s.name === icone);
---

<Base
  title="Links"
  description="Diagnóstico gratuito, produtos, preços e exemplos da Nuvio Studio num link só."
  class="min-h-dvh">
  <!-- Manchas do topo ao rodapé, com uma faixa escura entre uma e outra.
       Ficam num bloco da largura da tela que corta a sobra: sem o corte,
       a mancha que vaza para o lado alarga a página e o celular abre a
       página afastada. Por dentro, seguem a coluna do conteúdo. -->
  <div class="isolate relative overflow-hidden">
    <div class="-z-10 absolute inset-0" aria-hidden="true">
      <div class="relative mx-auto max-w-md h-full">
        <span class="-top-[4%] -left-16 absolute bg-blue-600 opacity-30 blur-3xl rounded-full w-72 aspect-square"></span>
        <span class="top-[22%] -right-16 absolute bg-violet-600 opacity-30 blur-3xl rounded-full w-72 aspect-square"></span>
        <span class="top-[48%] -left-16 absolute bg-blue-700 opacity-30 blur-3xl rounded-full w-72 aspect-square"></span>
        <span class="top-[74%] -right-16 absolute bg-purple-700 opacity-30 blur-3xl rounded-full w-72 aspect-square"></span>
      </div>
    </div>

    <main class="flex flex-col items-center mx-auto px-4 pt-16 pb-8 max-w-md min-h-dvh">
      <div class="p-2 rounded-[2rem] vidro-liquido motion-safe:animate-entra">
        <img src="/icon-192.png" alt="Nuvio Studio" width="80" height="80" class="rounded-3xl w-20 h-20" />
      </div>

      <h1 class="mt-4 font-display font-extrabold text-white text-3xl tracking-tight [text-shadow:0_2px_16px_rgba(0,0,0,.35)] motion-safe:animate-entra [animation-delay:80ms]">
        Nuvio Studio
      </h1>
      <p class="mt-1 max-w-xs text-white/75 text-sm text-center motion-safe:animate-entra [animation-delay:120ms]">
        O cliente te acha, escolhe e avalia sem você parar o atendimento.
      </p>

      <ul class="flex flex-wrap justify-center gap-2 mt-4 font-medium text-white/90 text-xs">
        <li class="px-4 py-1 rounded-full vidro-liquido motion-safe:animate-entra [animation-delay:160ms]">Sem mensalidade</li>
        <li class="px-4 py-1 rounded-full vidro-liquido motion-safe:animate-entra [animation-delay:200ms]">Entrega em até 7 dias</li>
      </ul>

      <ul class="space-y-4 mt-8 w-full">
        {
          links.map((l, i) => (
            <li>
              <a
                style={`animation-delay: ${220 + i * 60}ms`}
                href={l.href}
                target={l.externo ? "_blank" : undefined}
                rel={l.externo ? "noopener" : undefined}
                data-reflexo
                class:list={[
                  "group flex items-center gap-4 p-2 pr-4 rounded-full text-white vidro-liquido motion-safe:animate-entra",
                  "focus-visible:outline-2 focus-visible:outline-white/70 focus-visible:outline-offset-4",
                  i === 0 && "[--vidro-tinta:rgba(99,102,241,.35)]",
                ]}>
                <span class="place-items-center grid bg-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,.35)] rounded-full w-12 h-12 shrink-0">
                  {l.icone === "whatsapp" ? (
                    <WhatsApp class="w-5 h-5" />
                  ) : ehRede(l.icone) ? (
                    <Rede nome={l.icone} class="w-5 h-5" />
                  ) : (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={l.icone} />
                    </svg>
                  )}
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block font-semibold text-[15px]">{l.rotulo}</span>
                  <span class="block text-white/65 text-xs truncate">{l.detalhe}</span>
                </span>
                <Seta class="w-4 h-4 text-white/60 group-hover:text-white transition group-hover:translate-x-1 duration-300 shrink-0" />
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/" class="mt-auto pt-16 text-white/50 hover:text-white text-xs tracking-wide transition duration-300">
        nuviostudio.com.br
      </a>
    </main>
  </div>
</Base>

<script>
  import { aCadaPagina } from "../scripts/pagina";

  // Leva o reflexo do vidro (::after do `vidro-liquido`) para onde está o
  // dedo ou o mouse. Só grava a posição; o brilho em si é CSS.
  aCadaPagina((signal) => {
    const mover = (e: PointerEvent) => {
      const el = (e.target as Element | null)?.closest<HTMLElement>("[data-reflexo]");
      if (!el) return;
      const r = el.getBoundingClientRect();
      el.style.setProperty("--mx", `${e.clientX - r.left}px`);
      el.style.setProperty("--my", `${e.clientY - r.top}px`);
    };
    document.addEventListener("pointermove", mover, { signal, passive: true });
    document.addEventListener("pointerdown", mover, { signal, passive: true });
  });
</script>
