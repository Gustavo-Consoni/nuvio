---
/**
 * Demo: o que abre quando o cliente encosta o celular na plaquinha da mesa.
 * Cardápio com foto, preço e pedido pelo WhatsApp.
 */
import DemoOlivia from "../../../layouts/DemoOlivia.astro";
import { olivia, categorias, pratos, whatsapp } from "../../../data/demo-restaurante";

---

<DemoOlivia title="Cardápio" description="Veja os pratos da Casa Olívia com foto e preço e faça sua reserva pelo WhatsApp.">
  <header class="mx-auto px-4 pt-8 max-w-3xl">
    <div class="flex justify-between items-center">
      <a href="/demos/casa-olivia/links/" class="font-fraunces font-bold text-2xl">
        Casa <em class="font-medium text-olivia-terra">Olívia</em>
      </a>
      <span class="text-[10px] text-olivia-oliva uppercase tracking-[0.3em]">Cardápio</span>
    </div>
  </header>

  <main class="mx-auto px-4 pb-32 max-w-3xl">
    <section class="pt-8">
      <p class="text-[11px] text-olivia-oliva uppercase tracking-[0.3em]">Feito hoje, aqui na cozinha</p>
      <h1 class="mt-4 font-fraunces font-bold text-5xl sm:text-6xl leading-[0.95]">
        O que vai ser <em class="font-medium text-olivia-terra">hoje?</em>
      </h1>
      <p class="mt-4 max-w-md text-olivia-tinta/70 text-sm leading-relaxed">
        Veja os pratos com foto e preço. Quando decidir, é só chamar o garçom.
      </p>
    </section>

    <!-- filtro: sem JS todos os pratos aparecem e os botões não fazem nada -->
    <div data-filtros class="top-0 z-10 sticky flex gap-2 bg-olivia-papel/90 backdrop-blur -mx-4 mt-8 px-4 py-4 overflow-x-auto">
      <button type="button" data-filtro="todos" aria-pressed="true" class="px-4 py-2 border border-olivia-tinta/15 aria-pressed:border-olivia-terra rounded-full aria-pressed:bg-olivia-terra text-olivia-tinta/70 aria-pressed:text-olivia-cartao text-xs whitespace-nowrap transition duration-300 cursor-pointer">
        Todos
      </button>
      {
        categorias.map((c) => (
          <button type="button" data-filtro={c.id} aria-pressed="false" class="px-4 py-2 border border-olivia-tinta/15 aria-pressed:border-olivia-terra rounded-full aria-pressed:bg-olivia-terra text-olivia-tinta/70 aria-pressed:text-olivia-cartao text-xs whitespace-nowrap transition duration-300 cursor-pointer">
            {c.nome}
          </button>
        ))
      }
    </div>

    <div class="gap-4 grid sm:grid-cols-2 mt-4">
      {
        pratos.map((p, i) => (
          <article data-servico data-categoria={p.categoria} class="bg-olivia-cartao shadow-sm rounded-3xl overflow-hidden">
            <div class="relative bg-olivia-tinta/5 aspect-[4/3] overflow-hidden">
              <img
                src={p.foto}
                alt={p.nome}
                width="800"
                height="600"
                loading={i < 2 ? "eager" : "lazy"}
                class="absolute inset-0 w-full h-full object-cover"
              />
              <span class="top-4 right-4 absolute bg-olivia-cartao/95 px-4 py-1 rounded-full font-fraunces font-bold text-olivia-terra text-lg">R$ {p.preco}</span>
            </div>
            <div class="p-4">
              <div class="flex justify-between items-baseline gap-4">
                <h2 class="font-fraunces font-bold text-2xl">{p.nome}</h2>
                <span class="text-[11px] text-olivia-oliva shrink-0">{p.serve}</span>
              </div>
              <p class="mt-2 text-olivia-tinta/70 text-sm leading-relaxed">{p.descricao}</p>
            </div>
          </article>
        ))
      }
    </div>

    <section class="bg-olivia-oliva mt-16 p-8 rounded-3xl text-olivia-cartao text-center">
      <p class="font-fraunces font-bold text-2xl">Gostou da comida?</p>
      <p class="mt-2 text-olivia-cartao/80 text-sm">Sua avaliação no Google ajuda outras pessoas a acharem a gente.</p>
      <a href="#" class="inline-block bg-olivia-cartao hover:bg-olivia-papel mt-4 px-8 py-4 rounded-full font-semibold text-olivia-oliva text-sm transition duration-300">
        Avaliar no Google ★★★★★
      </a>
    </section>

    <p class="mt-8 text-olivia-tinta/50 text-xs text-center">
      {olivia.horarios.join(" · ")}
    </p>
  </main>

  <!-- reserva sempre à mão no celular -->
  <div class="right-0 bottom-0 left-0 z-20 fixed bg-gradient-to-t from-olivia-papel via-olivia-papel/95 to-transparent px-4 pt-8 pb-[max(1rem,env(safe-area-inset-bottom))]">
    <a
      href={whatsapp("Olá! Quero reservar uma mesa na Casa Olívia.")}
      target="_blank"
      rel="noopener"
      class="block bg-olivia-terra hover:bg-olivia-tinta mx-auto py-4 rounded-full max-w-3xl font-semibold text-olivia-cartao text-sm text-center transition duration-300">
      Reservar mesa pelo WhatsApp
    </a>
  </div>
</DemoOlivia>

<script>
  import { aCadaPagina } from "../../../scripts/pagina";

  aCadaPagina((signal) => {
    const barra = document.querySelector<HTMLElement>("[data-filtros]");
    if (!barra) return;
    const botoes = barra.querySelectorAll<HTMLElement>("[data-filtro]");
    const itens = document.querySelectorAll<HTMLElement>("[data-servico]");

    botoes.forEach((botao) =>
      botao.addEventListener(
        "click",
        () => {
          const filtro = botao.dataset.filtro;
          botoes.forEach((b) => b.setAttribute("aria-pressed", String(b === botao)));
          // o `display` de quem fica de fora está no global.css ([data-fora])
          itens.forEach((el) => el.toggleAttribute("data-fora", filtro !== "todos" && el.dataset.categoria !== filtro));
        },
        { signal },
      ),
    );
  });
</script>
