---
/**
 * Site demo da SpacePro, app de treino fictício. Tema próprio em
 * src/styles/demos/treino.css (ver src/layouts/DemoSite.astro).
 */
import DemoSite from "../../../layouts/DemoSite.astro";
import "../../../styles/demos/treino.css";
---

<DemoSite
  title="Plataforma de treino para resultados consistentes"
  marca="SpacePro"
  description="Treinos profissionais prontos para seguir na academia, com periodização, progressão de carga e renovação a cada 45 dias."
  fontes="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600&family=Poppins:wght@400;500;600;700&display=swap"
  corTema="#101010"
  icone="/demos/treino/static/images/logo.png">

  <!-- ================= HEADER ================= -->
  <header data-header
          class="fixed inset-x-0 top-0 z-50 py-5 transition-all duration-300 data-rolou:bg-breu/95 data-rolou:py-3 data-rolou:backdrop-blur-md">
    <div class="wrap flex items-center justify-between gap-6">
      <a href="#topo" class="flex shrink-0 items-center gap-3">
        <img src="/demos/treino/static/images/logo.png" alt="" width="48" height="48" class="h-9 w-9 object-contain" />
        <span class="font-display text-2xl font-medium uppercase tracking-[0.14em] text-white">SpacePro</span>
      </a>

      <nav class="hidden items-center gap-1 rounded-full border border-linha bg-carvao/80 px-2 py-1.5 backdrop-blur lg:flex">
        <a href="#aplicativo" class="rounded-full px-5 py-2 text-sm text-mudo transition duration-300 hover:bg-white/5 hover:text-white">Aplicativo</a>
        <a href="#transformacoes" class="rounded-full px-5 py-2 text-sm text-mudo transition duration-300 hover:bg-white/5 hover:text-white">Transformações</a>
        <a href="#planos" class="rounded-full px-5 py-2 text-sm text-mudo transition duration-300 hover:bg-white/5 hover:text-white">Planos</a>
        <a href="#duvidas" class="rounded-full px-5 py-2 text-sm text-mudo transition duration-300 hover:bg-white/5 hover:text-white">Dúvidas</a>
      </nav>

      <div class="flex shrink-0 items-center gap-3">
        <a href="#planos" class="btn-azul hidden sm:inline-flex">Área de Alunos</a>
        <button type="button" data-menu-botao aria-controls="menu-mobile" aria-expanded="false" aria-label="Abrir menu"
                class="group grid h-10 w-10 cursor-pointer place-items-center rounded-xl border border-linha text-white lg:hidden">
          <svg class="h-4 w-4 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="hidden h-4 w-4 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>

    <div id="menu-mobile" class="recolhe lg:hidden">
      <div>
      <div class="wrap mt-4">
        <div class="cartao space-y-1 p-3">
          <a href="#aplicativo" class="block rounded-xl px-4 py-3 text-sm text-mudo hover:bg-white/5 hover:text-white">Aplicativo</a>
          <a href="#transformacoes" class="block rounded-xl px-4 py-3 text-sm text-mudo hover:bg-white/5 hover:text-white">Transformações</a>
          <a href="#planos" class="block rounded-xl px-4 py-3 text-sm text-mudo hover:bg-white/5 hover:text-white">Planos</a>
          <a href="#duvidas" class="block rounded-xl px-4 py-3 text-sm text-mudo hover:bg-white/5 hover:text-white">Dúvidas</a>
          <a href="#planos" class="btn-azul mt-2 w-full">Área de Alunos</a>
        </div>
      </div>
      </div>
    </div>
  </header>

  <!-- ================= HERO ================= -->
  <section id="topo" class="relative min-h-screen overflow-hidden">
    <!-- No site original aqui roda um vídeo de fundo. Num demo que abre dentro
         de um modal, 4,5 MB de vídeo custa caro, então usamos um quadro dele. -->
    <img src="/demos/treino/static/images/hero.webp" alt="" width="1600" height="900"
         decoding="async" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-breu/70"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-breu to-transparent"></div>

    <div class="wrap relative flex min-h-screen flex-col items-center justify-center py-32 text-center">
      <p class="inline-flex items-center gap-2 rounded-full border border-amarelo/40 bg-amarelo/10 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-amarelo">
        <span class="h-1.5 w-1.5 rounded-full bg-amarelo"></span>
        Disponível para Android e iOS
      </p>

      <h1 class="titulo mt-8 max-w-4xl !text-5xl sm:!text-6xl lg:!text-7xl">
        Treinos profissionais prontos para você seguir na academia
      </h1>

      <p class="mt-7 max-w-xl text-[15px] leading-relaxed text-mudo">
        Programação completa com periodização e renovação a cada 45 dias, seja
        qual for o seu nível de condicionamento físico.
      </p>

      <a href="#planos" class="btn-azul mt-9">Comece agora</a>
    </div>
  </section>

  <!-- ================= PILARES ================= -->
  <section class="relative z-10 -mt-24 pb-20">
    <div class="wrap grid gap-6 md:grid-cols-3">
      <article class="cartao p-7 rv" data-revelar>
        <span class="grid h-12 w-12 place-items-center rounded-xl bg-azul/15 text-azul-cl">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4L2 9l10 5 10-5-10-5zM5 11v5c0 1.5 3 3 7 3s7-1.5 7-3v-5"/></svg>
        </span>
        <h2 class="mt-6 font-display text-2xl font-medium uppercase text-white">Experiência</h2>
        <span class="mt-3 block h-0.5 w-10 bg-amarelo"></span>
        <p class="mt-5 text-sm leading-relaxed text-mudo">
          Treinar com a gente é contar com profissionais altamente qualificados,
          capacitados e realmente apaixonados pelo que fazem.
        </p>
      </article>

      <article class="cartao p-7 rv" data-revelar data-atraso="110">
        <span class="grid h-12 w-12 place-items-center rounded-xl bg-azul/15 text-azul-cl">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 19l3-3m0 0a9 9 0 0111-11 9 9 0 01-11 11zm0 0l-3 3m10-13a2 2 0 100 4 2 2 0 000-4z"/></svg>
        </span>
        <h2 class="mt-6 font-display text-2xl font-medium uppercase text-white">Resultado</h2>
        <span class="mt-3 block h-0.5 w-10 bg-amarelo"></span>
        <p class="mt-5 text-sm leading-relaxed text-mudo">
          Nosso plano de ação combina periodização, progressão de carga e renovação
          de treino para que seu corpo nunca entre em estagnação.
        </p>
      </article>

      <article class="cartao p-7 rv" data-revelar data-atraso="220">
        <span class="grid h-12 w-12 place-items-center rounded-xl bg-azul/15 text-azul-cl">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
        </span>
        <h2 class="mt-6 font-display text-2xl font-medium uppercase text-white">Acessibilidade</h2>
        <span class="mt-3 block h-0.5 w-10 bg-amarelo"></span>
        <p class="mt-5 text-sm leading-relaxed text-mudo">
          Seja qual for sua rotina, local ou disponibilidade, nossa plataforma está
          sempre ao seu alcance, garantindo que você nunca perca o ritmo.
        </p>
      </article>
    </div>
  </section>

  <!-- ================= APLICATIVO ================= -->
  <section id="aplicativo" class="overflow-hidden py-20 lg:py-28">
    <div class="wrap grid items-center gap-14 lg:grid-cols-2 lg:gap-20">

      <div class="rv" data-revelar>
        <div class="relative mx-auto w-full max-w-[300px]">
          <div class="pointer-events-none absolute -inset-10 rounded-full bg-azul/20 blur-3xl"></div>
          <div class="relative overflow-hidden rounded-[2.2rem] border-[6px] border-linha bg-carvao">
            <img src="/demos/treino/static/images/app.webp" alt="Tela do aplicativo SpacePro com a frequência de treinos"
                 width="560" height="1115" loading="lazy" decoding="async" class="block w-full" />
          </div>
        </div>
      </div>

      <div class="rv" data-revelar data-atraso="120">
        <p class="rotulo">Aplicativo exclusivo</p>
        <h2 class="titulo mt-6">Seu treino na palma<br />de suas mãos</h2>

        <ul class="mt-9 divide-y divide-linha">
          <li class="check py-3.5">Vídeos demonstrativos dos exercícios</li>
          <li class="check py-3.5">Cronômetro para descansos entre séries</li>
          <li class="check py-3.5">Registro de carga dos exercícios</li>
          <li class="check py-3.5">Histórico de frequência de treinos</li>
          <li class="check py-3.5">Metodologias descritas com exemplos</li>
          <li class="check py-3.5">Níveis iniciante, intermediário e avançado</li>
          <li class="check py-3.5">Treinos renovados a cada 45 dias</li>
          <li class="check py-3.5">Acesso à comunidade SpacePro</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= COMUNIDADE ================= -->
  <section class="py-20 lg:py-28">
    <div class="wrap grid items-center gap-14 lg:grid-cols-2 lg:gap-20">

      <div class="rv" data-revelar>
        <p class="rotulo">Comunidade SpacePro</p>
        <p class="mt-6 font-display text-7xl font-medium leading-none text-white sm:text-8xl">300<span class="text-amarelo">+</span></p>
        <h2 class="mt-3 font-display text-3xl font-medium uppercase text-white">Alunos satisfeitos</h2>

        <div class="mt-5 flex gap-1 text-amarelo" role="img" aria-label="Nota 5 de 5">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
        </div>

        <p class="mt-6 max-w-md text-sm leading-relaxed text-mudo">
          Nosso compromisso é oferecer treinos que superem as expectativas,
          garantindo qualidade, confiança e excelência em cada momento.
        </p>
        <a href="#planos" class="btn-azul mt-8">Comece agora</a>
      </div>

      <div class="text-center rv" data-revelar data-atraso="120">
        <div class="overflow-hidden rounded-2xl">
          <img src="/demos/treino/static/images/dupla.webp" alt="Dois alunos treinando com halteres na academia"
               width="900" height="694" loading="lazy" decoding="async" class="block w-full object-cover" />
        </div>
        <h2 class="titulo mt-8">Construa seu físico<br />guiado pelos melhores</h2>
        <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed text-mudo">
          Seu objetivo é nossa especialidade. Alcance o físico que você sempre
          desejou com a orientação de quem realmente entende do assunto.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= TRANSFORMAÇÕES ================= -->
  <section id="transformacoes" class="py-20 lg:py-28">
    <div class="wrap text-center rv" data-revelar>
      <p class="rotulo rotulo-centro">Resultados</p>
      <h2 class="titulo mt-6">Transformações para você se inspirar</h2>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-mudo">
        Cada foto é prova de que nosso método funciona. Veja o que acontece quando
        disciplina e acompanhamento profissional se encontram.
      </p>
    </div>

    <div class="mt-14 overflow-hidden">
      <div class="marquee flex w-max gap-4">
        <div class="flex shrink-0 gap-4">
          <img src="/demos/treino/static/images/t1.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t2.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t3.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t4.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t5.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t6.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t7.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t8.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t9.webp"  alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t10.webp" alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t11.webp" alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t12.webp" alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t13.webp" alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t14.webp" alt="Antes e depois de um aluno"  width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
        </div>
        <div class="flex shrink-0 gap-4" aria-hidden="true">
          <img src="/demos/treino/static/images/t1.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t2.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t3.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t4.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t5.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t6.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t7.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t8.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t9.webp"  alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t10.webp" alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t11.webp" alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t12.webp" alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t13.webp" alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
          <img src="/demos/treino/static/images/t14.webp" alt="" width="400" height="300" loading="lazy" decoding="async" class="h-48 w-auto rounded-xl object-cover sm:h-60" />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PLANOS ================= -->
  <section id="planos" class="py-20 lg:py-28">
    <div class="wrap">
      <div class="text-center rv" data-revelar>
        <p class="rotulo rotulo-centro">Planos</p>
        <h2 class="titulo mt-6">Seu primeiro passo para evolução</h2>
        <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed text-mudo">
          Escolha o plano certo para seus objetivos e cancele quando quiser, sem
          fidelidade ou burocracia.
        </p>
      </div>

      <!-- alternador de ciclo -->
      <div class="mt-10 flex justify-center">
        <div class="inline-flex rounded-full border border-amarelo/40 bg-amarelo/10 p-1">
          <button type="button" data-ciclo="mensal" aria-pressed="true"
                  class="cursor-pointer rounded-full text-mudo hover:text-white aria-pressed:bg-amarelo aria-pressed:text-breu px-6 py-2 text-sm font-semibold transition duration-300">Mensal</button>
          <button type="button" data-ciclo="trimestral" aria-pressed="false"
                  class="cursor-pointer rounded-full text-mudo hover:text-white aria-pressed:bg-amarelo aria-pressed:text-breu px-6 py-2 text-sm font-semibold transition duration-300">Trimestral</button>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-mudo2">
        <span data-desconto hidden>20% de desconto no pagamento trimestral</span>
      </p>

      <div class="mt-12 grid items-start gap-6 lg:grid-cols-3">

        <article class="cartao p-7 rv" data-revelar>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-mudo2">Masculino</p>
          <p class="mt-5 font-display text-5xl font-medium text-white">
            <span data-mensal="R$ 49,90" data-trimestral="R$ 39,90">R$ 49,90</span>{" "}
            <span class="font-sans text-base font-normal text-mudo2">/ mês</span>
          </p>
          <p class="mt-4 text-sm leading-relaxed text-mudo">Projetado para impulsionar a força e vitalidade dos homens.</p>
          <a href="#topo" class="btn-azul mt-7 w-full">Comece agora</a>
          <p class="mt-8 border-t border-linha pt-6 text-sm font-semibold text-white">O que está incluso?</p>
          <ul class="mt-5 space-y-3.5">
            <li class="check">Treinos masculinos</li>
            <li class="check">Vídeos demonstrativos</li>
            <li class="check">Registro de frequência</li>
            <li class="check">Metodologia descrita</li>
            <li class="check">Controle de carga</li>
            <li class="check">Cronômetro de descanso</li>
          </ul>
        </article>

        <article class="relative rounded-2xl border-2 border-azul bg-carvao p-7 shadow-2xl shadow-azul/15 rv" data-revelar data-atraso="110">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-azul px-4 py-1 text-[11px] font-semibold text-white">Econômico</span>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-mudo2">Casal</p>
          <p class="mt-5 font-display text-5xl font-medium text-white">
            <span data-mensal="R$ 79,90" data-trimestral="R$ 63,90">R$ 79,90</span>{" "}
            <span class="font-sans text-base font-normal text-mudo2">/ mês</span>
          </p>
          <p class="mt-4 text-sm leading-relaxed text-mudo">Ideal para treinar junto com sua companhia de academia.</p>
          <a href="#topo" class="btn-azul mt-7 w-full">Comece agora</a>
          <p class="mt-8 border-t border-linha pt-6 text-sm font-semibold text-white">O que está incluso?</p>
          <ul class="mt-5 space-y-3.5">
            <li class="check">Treinos masculinos</li>
            <li class="check">Treinos femininos</li>
            <li class="check">Vídeos demonstrativos</li>
            <li class="check">Registro de frequência</li>
            <li class="check">Metodologia descrita</li>
            <li class="check">Controle de carga</li>
