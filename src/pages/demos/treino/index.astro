<script>
  import { aCadaPagina } from "../../../scripts/pagina";
  import { menu, revelar, rolagem } from "../../../scripts/demos";

  aCadaPagina((signal) => {
    rolagem(document.querySelectorAll("[data-header]"), signal);
    menu(signal, 1024);
    revelar(signal);
    ciclo(signal);
  });

  /** Mensal ou trimestral: os dois preços de cada plano estão no HTML
   *  (`data-mensal`, `data-trimestral`); o botão só escolhe qual mostrar. */
  function ciclo(signal: AbortSignal) {
    const botoes = document.querySelectorAll<HTMLElement>("[data-ciclo]");
    const precos = document.querySelectorAll<HTMLElement>("[data-mensal]");
    const desconto = document.querySelector<HTMLElement>("[data-desconto]");
    botoes.forEach((b) =>
      b.addEventListener(
        "click",
        () => {
          const trimestral = b.dataset.ciclo === "trimestral";
          botoes.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
          precos.forEach((p) => (p.textContent = trimestral ? p.dataset.trimestral! : p.dataset.mensal!));
          if (desconto) desconto.hidden = !trimestral;
        },
        { signal },
      ),
    );
  }
</script>
