  <!-- ================= AGENDAMENTO ================= -->
  <section id="agendar" class="py-24 lg:py-40">
    <div class="wrap grid items-center gap-16 lg:grid-cols-2">

      <div class="rv" data-revelar>
        <!-- moldura dourada deslocada, como no layout original -->
        <div class="relative">
          <span class="pointer-events-none absolute left-5 top-5 h-full w-full border border-gold"></span>
          <div class="foto relative aspect-[1.11]">
            <img src="/demos/barbearia/static/images/cadeira.webp" alt="Cadeira e salão da Blade &amp; Co." width="1000" height="900"
                 loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
          </div>
        </div>
      </div>

      <div>
        <p class="rotulo">Reserve seu horário</p>
        <h2 class="titulo mt-7">Agende sua <em>Visita</em></h2>
        <!-- nasce com `hidden`: sem JavaScript o pedido nunca é enviado -->
        <div data-enviado hidden
             class="animate-surge motion-reduce:animate-none mt-10 flex flex-col justify-center border border-gold/30 p-10 text-center">
          <span class="mx-auto text-3xl text-gold">✓</span>
          <h3 class="mt-6 font-display text-2xl uppercase tracking-[0.1em] text-bone">Pedido enviado</h3>
          <p class="mt-4 text-sm leading-relaxed text-mute">
            Obrigado, <span class="text-cream" data-primeiro-nome></span>.
            Confirmamos seu horário por WhatsApp ainda hoje.
          </p>
          <button type="button" data-novo-pedido class="btn-linha mx-auto mt-8">Fazer outro pedido</button>
        </div>

        <form data-agendamento novalidate class="mt-10 space-y-8">
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <label for="nome" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">Nome</label>
              <input id="nome" type="text" name="nome" placeholder="João" class="campo mt-2 aria-invalid:border-red-500/70" />
              <p data-erro="nome" hidden class="mt-2 text-[11px] text-red-400"></p>
            </div>
            <div>
              <label for="sobrenome" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">Sobrenome</label>
              <input id="sobrenome" type="text" name="sobrenome" placeholder="Silva" class="campo mt-2 aria-invalid:border-red-500/70" />
              <p data-erro="sobrenome" hidden class="mt-2 text-[11px] text-red-400"></p>
            </div>
          </div>

          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <label for="email" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">E-mail</label>
              <input id="email" type="email" name="email" placeholder="joao@email.com" class="campo mt-2 aria-invalid:border-red-500/70" />
              <p data-erro="email" hidden class="mt-2 text-[11px] text-red-400"></p>
            </div>
            <div>
              <label for="tel" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">Telefone</label>
              <input id="tel" type="tel" name="tel" maxlength="15" placeholder="(11) 99999-9999" class="campo mt-2 aria-invalid:border-red-500/70" />
              <p data-erro="tel" hidden class="mt-2 text-[11px] text-red-400"></p>
            </div>
          </div>

          <div>
            <label for="servico" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">Selecionar serviço</label>
            <select id="servico" name="servico" class="campo mt-2">
              <option class="bg-surface">Corte exclusivo &middot; R$ 45</option>
              <option class="bg-surface">Barbear na navalha &middot; R$ 55</option>
              <option class="bg-surface">Modelagem de barba &middot; R$ 35</option>
              <option class="bg-surface">O completo &middot; R$ 95</option>
              <option class="bg-surface">Design capilar &middot; R$ 60</option>
              <option class="bg-surface">Tratamento capilar &middot; R$ 70</option>
              <option class="bg-surface">Disfarce de grisalhos &middot; R$ 50</option>
              <option class="bg-surface">Cuidado facial &middot; R$ 65</option>
            </select>
          </div>

          <div>
            <label for="barbeiro" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">Barbeiro preferido</label>
            <select id="barbeiro" name="barbeiro" class="campo mt-2">
              <option class="bg-surface">Sem preferência</option>
              <option class="bg-surface">Jonas Ribeiro</option>
              <option class="bg-surface">Marcelo Chagas</option>
              <option class="bg-surface">Diego Alencar</option>
            </select>
          </div>

          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <label for="data" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">Data</label>
              <input id="data" type="date" name="data" class="campo mt-2 [color-scheme:dark] aria-invalid:border-red-500/70" />
              <p data-erro="data" hidden class="mt-2 text-[11px] text-red-400"></p>
            </div>
            <div>
              <label for="hora" class="block text-[0.65rem] uppercase tracking-[0.25em] text-mute">Horário</label>
              <input id="hora" type="time" name="hora" class="campo mt-2 [color-scheme:dark] aria-invalid:border-red-500/70" />
              <p data-erro="hora" hidden class="mt-2 text-[11px] text-red-400"></p>
            </div>
          </div>

          <button type="submit"
                  class="btn-gold w-full cursor-pointer py-[1.2rem] text-[0.75rem] tracking-[0.25em] disabled:opacity-60">
            <span data-rotulo-envio>Confirmar agendamento</span>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>

          <p class="text-center text-[11px] text-mute2">
            O pedido não confirma o horário sozinho. A gente responde no WhatsApp para fechar.
          </p>
        </form>
      </div>
    </div>
  </section>

