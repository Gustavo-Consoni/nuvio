<script>
  import { aCadaPagina } from "../../../scripts/pagina";
  import {
    contar,
    emailValido,
    esperar,
    mascaraTelefone,
    menu,
    paralaxe,
    revelar,
    rolagem,
    semMovimento,
  } from "../../../scripts/demos";

  aCadaPagina((signal) => {
    rolagem(document.querySelectorAll("[data-header]"), signal);
    menu(signal, 1024);
    revelar(signal);
    contar(signal);
    paralaxe(document.querySelector<HTMLElement>(".img-hero"), 0.15, signal);
    depoimentos(signal);
    agendamento(signal);
  });

  /** Um depoimento por vez. Trocam sozinhos a cada 5s; um clique no dot
   *  reinicia a contagem para o visitante não perder o que escolheu. */
  function depoimentos(signal: AbortSignal) {
    const figuras = [...document.querySelectorAll<HTMLElement>("[data-depoimento]")];
    const dots = [...document.querySelectorAll<HTMLElement>("[data-ver-depoimento]")];
    let atual = 0;
    let giro: ReturnType<typeof setInterval> | undefined;

    const ver = (i: number) => {
      atual = i;
      figuras.forEach((f, j) => f.toggleAttribute("data-ativo", j === i));
      dots.forEach((d, j) => d.setAttribute("aria-current", String(j === i)));
    };
    const rodar = () => {
      if (semMovimento()) return;
      clearInterval(giro);
      giro = setInterval(() => ver((atual + 1) % figuras.length), 5000);
    };

    dots.forEach((d, i) => d.addEventListener("click", () => (ver(i), rodar()), { signal }));
    rodar();
    signal.addEventListener("abort", () => clearInterval(giro));
  }

  function agendamento(signal: AbortSignal) {
    const form = document.querySelector<HTMLFormElement>("[data-agendamento]");
    const enviado = document.querySelector<HTMLElement>("[data-enviado]");
    if (!form || !enviado) return;
    const campo = (nome: string) => form.elements.namedItem(nome) as HTMLInputElement;
    const valor = (nome: string) => campo(nome).value.trim();
    const botao = form.querySelector<HTMLButtonElement>("[type=submit]")!;
    const rotulo = form.querySelector<HTMLElement>("[data-rotulo-envio]")!;

    const mostrarErros = (erros: Record<string, string>) =>
      form.querySelectorAll<HTMLElement>("[data-erro]").forEach((p) => {
        const nome = p.dataset.erro!;
        const msg = erros[nome];
        p.textContent = msg ?? "";
        p.hidden = !msg;
        if (msg) campo(nome).setAttribute("aria-invalid", "true");
        else campo(nome).removeAttribute("aria-invalid");
      });

    const validar = () => {
      const erros: Record<string, string> = {};
      if (valor("nome").length < 2) erros.nome = "Informe seu nome.";
      if (valor("sobrenome").length < 2) erros.sobrenome = "Informe seu sobrenome.";
      if (!emailValido(valor("email"))) erros.email = "E-mail inválido.";
      if (valor("tel").replace(/\D/g, "").length < 10) erros.tel = "Telefone com DDD.";
      if (!valor("data")) erros.data = "Escolha uma data.";
      if (!valor("hora")) erros.hora = "Escolha um horário.";
      mostrarErros(erros);
      return !Object.keys(erros).length;
    };

    campo("tel").addEventListener("input", () => (campo("tel").value = mascaraTelefone(campo("tel").value)), { signal });

    form.addEventListener(
      "submit",
      async (e) => {
        e.preventDefault();
        if (!validar()) return;
        botao.disabled = true;
        rotulo.textContent = "Enviando…";
        // Demo: o envio é simulado. Num site real, troque a espera por um
        // fetch para Formspree, Web3Forms ou um webhook.
        await esperar(1000, signal).catch(() => {});
        if (signal.aborted) return;
        botao.disabled = false;
        rotulo.textContent = "Confirmar agendamento";
        enviado.querySelector("[data-primeiro-nome]")!.textContent = valor("nome").split(" ")[0];
        form.hidden = true;
        enviado.hidden = false;
      },
      { signal },
    );

    enviado.querySelector("[data-novo-pedido]")?.addEventListener(
      "click",
      () => {
        form.reset();
        mostrarErros({});
        enviado.hidden = true;
        form.hidden = false;
      },
      { signal },
    );
  }
</script>
