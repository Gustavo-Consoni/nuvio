---
/**
 * Site demo da Blade & Co., barbearia fictícia. Mesma barbearia do catálogo
 * de cortes e da página de links (cortes.astro, links.astro), mas com tema
 * próprio: src/styles/demos/barbearia.css.
 */
import DemoSite from "../../../layouts/DemoSite.astro";
import { fontesBlade } from "../../../data/demo-barbearia";
import "../../../styles/demos/barbearia.css";
---

<DemoSite
  title="Barbearia Premium"
  marca="BLADE & CO."
  description="Barbearia premium onde a técnica tradicional encontra o corte contemporâneo. Corte exclusivo, barbear com toalha quente e cuidado de barba."
  fontes={fontesBlade}
  corTema="#0a0a0a">

  <!-- ================= HEADER ================= -->
  <header data-header
          class="fixed inset-x-0 top-0 z-50 py-7 transition-all duration-300 data-rolou:border-b data-rolou:border-line data-rolou:bg-void/95 data-rolou:py-4 data-rolou:backdrop-blur-md">
    <div class="mx-auto flex w-full max-w-[1600px] items-center justify-between gap-8 px-6 sm:px-10 lg:px-12">
      <a href="#topo" class="font-display text-2xl uppercase tracking-[0.18em] text-bone">
        Blade <span class="font-serif text-lg italic tracking-normal text-gold">&amp;</span> Co.
      </a>

      <nav class="hidden items-center gap-10 lg:flex">
        <a href="#historia" class="nav-link">Nossa história</a>
        <a href="#servicos" class="nav-link">Serviços</a>
        <a href="#galeria" class="nav-link">Galeria</a>
        <a href="#barbeiros" class="nav-link">Barbeiros</a>
        <a href="#avaliacoes" class="nav-link">Avaliações</a>
      </nav>

      <a href="#agendar" class="btn-linha hidden lg:inline-flex">Agendar agora</a>

      <button type="button" data-menu-botao aria-controls="menu-mobile" aria-expanded="false" aria-label="Abrir menu"
              class="group grid h-10 w-10 cursor-pointer place-items-center border border-line text-bone lg:hidden">
        <svg class="h-4 w-4 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="hidden h-4 w-4 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div id="menu-mobile" class="recolhe lg:hidden">
      <div>
      <div class="mx-auto w-full max-w-[1600px] space-y-1 border-t border-line px-6 pt-6 mt-6 sm:px-10 lg:px-12">
        <a href="#historia" class="block py-3 text-[11px] uppercase tracking-[0.2em] text-mute hover:text-gold">Nossa história</a>
        <a href="#servicos" class="block py-3 text-[11px] uppercase tracking-[0.2em] text-mute hover:text-gold">Serviços</a>
        <a href="#galeria" class="block py-3 text-[11px] uppercase tracking-[0.2em] text-mute hover:text-gold">Galeria</a>
        <a href="#barbeiros" class="block py-3 text-[11px] uppercase tracking-[0.2em] text-mute hover:text-gold">Barbeiros</a>
        <a href="#avaliacoes" class="block py-3 text-[11px] uppercase tracking-[0.2em] text-mute hover:text-gold">Avaliações</a>
        <a href="#agendar" class="btn-gold mt-4 w-full">Agendar agora</a>
      </div>
      </div>
    </div>
  </header>

  <!-- ================= HERO ================= -->
  <section id="topo" class="relative min-h-screen">
    <div class="grid min-h-screen lg:grid-cols-2">

      <div class="flex items-center px-6 pt-32 pb-16 sm:px-10 lg:pl-20 lg:pr-16 lg:pt-0 lg:pb-0">
        <div class="max-w-xl">
          <p class="rotulo rotulo-hero">Fundada em 2018 &middot; Cuidado premium</p>

          <h1 class="titulo titulo-hero mt-8">
            Onde o ofício<br />encontra<br /><span class="vazado">&amp; a tradição</span>
          </h1>

          <p class="mt-8 max-w-[420px] text-base leading-[1.8] text-mute">
            Cada corte carrega uma história. Nossos mestres barbeiros unem técnica
            consagrada pelo tempo e leitura contemporânea para esculpir o visual
            que é só seu.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-6">
            <a href="#agendar" class="btn-gold">
              Reserve sua cadeira
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href="#servicos" class="btn-nu">
              Explorar serviços
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="foto min-h-[55vh] lg:min-h-screen">
        <img src="/demos/barbearia/static/images/hero.webp" alt="Mestre barbeiro finalizando um corte" width="900" height="1250" decoding="async" fetchpriority="high" class="img-hero absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-void/25"></div>
        <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-void to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <section class="overflow-hidden border-y border-gold/10 py-8" aria-label="O que fazemos">
    <div class="marquee flex w-max items-center">
      <div class="flex shrink-0 items-center gap-10 px-10">
        <span class="faixa-item">Cuidado premium</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Barbear com toalha quente</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Modelagem de barba</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Cortes clássicos</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Design capilar</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Hora marcada</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Clube do cavalheiro</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Navalha reta</span><span class="faixa-ponto"></span>
      </div>
      <div class="flex shrink-0 items-center gap-10 px-10" aria-hidden="true">
        <span class="faixa-item">Cuidado premium</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Barbear com toalha quente</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Modelagem de barba</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Cortes clássicos</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Design capilar</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Hora marcada</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Clube do cavalheiro</span><span class="faixa-ponto"></span>
        <span class="faixa-item">Navalha reta</span><span class="faixa-ponto"></span>
      </div>
    </div>
  </section>

  <!-- ================= HISTÓRIA ================= -->
  <section id="historia" class="py-24 lg:py-40">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">

      <div class="rv relative pb-[16%]" data-revelar>
        <span class="pointer-events-none absolute -top-8 right-12 select-none font-display text-[10rem] leading-none text-gold/[0.06]">B&amp;C</span>
        <div class="foto relative z-10 aspect-[0.82] w-[72%]">
          <img src="/demos/barbearia/static/images/interior.webp" alt="Interior da barbearia" width="700" height="854" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover grayscale-[30%] transition duration-500 hover:grayscale-0" />
        </div>
        <div class="foto absolute bottom-0 right-0 z-20 aspect-square w-[55%] ring-[5px] ring-void">
          <img src="/demos/barbearia/static/images/ferramentas.webp" alt="Ferramentas de barbeiro sobre a bancada" width="660" height="660" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover grayscale-[30%] transition duration-500 hover:grayscale-0" />
        </div>
      </div>

      <div class="flex flex-col justify-center rv" data-revelar data-atraso="120">
        <p class="rotulo">Nossa história</p>
        <h2 class="titulo mt-7">Mais que uma<br />barbearia.<br />Um <em>Legado</em>.</h2>
        <p class="mt-8 text-[0.95rem] leading-[1.9] text-mute">
          Começamos com uma cadeira, uma navalha e a convicção de que cuidar da
          aparência é um ritual, não uma tarefa. Sete anos depois, a régua continua
          a mesma: tempo suficiente para cada cliente, produto que a gente usaria
          em si mesmo e um acabamento que se percebe de longe.
        </p>
        <p class="mt-6 text-[0.95rem] leading-[1.9] text-mute">
          Não trabalhamos com fila. Trabalhamos com hora marcada, café na mão e
          conversa quando você quiser.
        </p>

        <div class="mt-10 grid grid-cols-3 gap-12 border-t border-gold/15 pt-10">
          <div>
            <p class="num-stat" data-contar>7</p>
            <p class="mt-1 text-[0.7rem] uppercase tracking-[0.2em] text-mute2">Anos de casa</p>
          </div>
          <div>
            <p class="num-stat" data-contar>12k</p>
            <p class="mt-1 text-[0.7rem] uppercase tracking-[0.2em] text-mute2">Cortes feitos</p>
          </div>
          <div>
            <p class="num-stat" data-contar>4.9</p>
            <p class="mt-1 text-[0.7rem] uppercase tracking-[0.2em] text-mute2">Nota no Google</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVIÇOS ================= -->
  <section id="servicos" class="py-24 lg:pt-32 lg:pb-40">
    <div class="wrap">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="rv" data-revelar>
          <p class="rotulo">O que oferecemos</p>
          <h2 class="titulo mt-7">Nossos serviços<br /><em>Premium</em></h2>
        </div>
        <p class="max-w-[350px] text-[0.9rem] leading-[1.8] text-mute lg:text-right">
          Cada serviço é executado com precisão e calma, com produto de primeira
          e técnica que já provou que funciona.
        </p>
      </div>

      <div class="mt-20 grid gap-px bg-gold/10 sm:grid-cols-2 lg:grid-cols-4">

        <article class="group relative bg-void px-8 py-12">
          <svg aria-hidden="true" class="absolute right-8 top-8 h-5 w-5 translate-x-2 -translate-y-2 text-gold opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
          <svg aria-hidden="true" class="h-[2.2rem] w-[2.2rem] text-gold transition duration-400 group-hover:scale-110" viewBox="0 0 24 24"><path d="M6.654 1.633a.75.75 0 0 0-1.308.735l5.794 10.304l-2.708 4.815a3.751 3.751 0 1 0-.136 3.303L12 14.202l3.704 6.588a3.75 3.75 0 1 0-.136-3.303l-2.708-4.815l5.794-10.304a.75.75 0 0 0-1.308-.735L12 11.142z" fill="currentColor"/></svg>
          <h3 class="nome-servico mt-8">Corte exclusivo</h3>
          <p class="mt-3 text-[0.85rem] leading-[1.7] text-mute2">Corte sob medida, com consulta antes da tesoura, toalha quente e finalização precisa.</p>
          <div class="mt-8 flex items-center justify-between border-t border-gold/10 pt-6">
            <span class="font-display text-[1.6rem] leading-[normal] text-gold">R$ 45</span>
            <span class="text-[0.7rem] uppercase tracking-[0.15em] text-mute2">45 min</span>
          </div>
        </article>

        <article class="group relative bg-void px-8 py-12">
          <svg aria-hidden="true" class="absolute right-8 top-8 h-5 w-5 translate-x-2 -translate-y-2 text-gold opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
          <svg aria-hidden="true" class="h-[2.2rem] w-[2.2rem] text-gold transition duration-400 group-hover:scale-110" viewBox="0 0 24 24"><path d="M12.832 21.801c3.126-.626 7.168-2.875 7.168-8.69c0-5.291-3.873-8.815-6.658-10.434c-.619-.36-1.342.113-1.342.828v1.828c0 1.442-.606 4.074-2.29 5.169c-.86.559-1.79-.278-1.894-1.298l-.086-.838c-.1-.974-1.092-1.565-1.87-.971C4.461 8.46 3 10.33 3 13.11C3 20.221 8.289 22 10.933 22q.232 0 .484-.015C10.111 21.874 8 21.064 8 18.444c0-2.05 1.495-3.435 2.631-4.11c.306-.18.663.055.663.41v.59c0 .45.175 1.155.59 1.637c.47.546 1.159-.026 1.214-.744c.018-.226.246-.37.442-.256c.641.375 1.46 1.175 1.46 2.473c0 2.048-1.129 2.99-2.168 3.357" fill="currentColor"/></svg>
          <h3 class="nome-servico mt-8">Barbear na navalha</h3>
          <p class="mt-3 text-[0.85rem] leading-[1.7] text-mute2">Barbear tradicional na navalha, com preparo de toalha quente, espuma premium e bálsamo no fim.</p>
          <div class="mt-8 flex items-center justify-between border-t border-gold/10 pt-6">
            <span class="font-display text-[1.6rem] leading-[normal] text-gold">R$ 55</span>
            <span class="text-[0.7rem] uppercase tracking-[0.15em] text-mute2">50 min</span>
          </div>
        </article>

        <article class="group relative bg-void px-8 py-12">
          <svg aria-hidden="true" class="absolute right-8 top-8 h-5 w-5 translate-x-2 -translate-y-2 text-gold opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
          <svg aria-hidden="true" class="h-[2.2rem] w-[2.2rem] text-gold transition duration-400 group-hover:scale-110" viewBox="0 0 24 24"><path d="m20.092 14.326l.193-1.894c.103-1.011.17-1.678.117-2.099h.02c.871 0 1.578-.746 1.578-1.666S21.293 7 20.421 7s-1.579.746-1.579 1.667c0 .416.145.797.384 1.089c-.343.223-.792.695-1.468 1.405c-.52.547-.78.82-1.07.863a.84.84 0 0 1-.473-.07c-.268-.124-.447-.462-.804-1.139L13.527 7.25c-.22-.417-.405-.766-.572-1.047c.683-.368 1.15-1.117 1.15-1.98C14.105 2.994 13.163 2 12 2s-2.105.995-2.105 2.222c0 .864.467 1.613 1.15 1.98c-.167.282-.351.631-.572 1.048L8.59 10.816c-.358.676-.537 1.014-.805 1.139a.84.84 0 0 1-.473.07c-.29-.043-.55-.317-1.07-.864c-.676-.71-1.125-1.182-1.468-1.405c.24-.292.384-.673.384-1.09C5.158 7.747 4.45 7 3.578 7C2.708 7 2 7.746 2 8.667c0 .92.707 1.666 1.579 1.666h.019c-.054.42.014 1.088.117 2.099l.193 1.894c.107 1.051.196 2.051.306 2.952h15.572c.11-.9.199-1.901.306-2.952M10.855 22h2.29c2.985 0 4.478 0 5.474-.94c.434-.412.71-1.152.908-2.116H4.473c.198.964.473 1.704.908 2.115C6.377 22 7.87 22 10.855 22" fill="currentColor"/></svg>
          <h3 class="nome-servico mt-8">Modelagem de barba</h3>
          <p class="mt-3 text-[0.85rem] leading-[1.7] text-mute2">Desenho, aparo e condicionamento com óleos e bálsamos escolhidos para o formato do seu rosto.</p>
          <div class="mt-8 flex items-center justify-between border-t border-gold/10 pt-6">
            <span class="font-display text-[1.6rem] leading-[normal] text-gold">R$ 35</span>
            <span class="text-[0.7rem] uppercase tracking-[0.15em] text-mute2">30 min</span>
          </div>
        </article>

        <article class="group relative bg-void px-8 py-12">
          <svg aria-hidden="true" class="absolute right-8 top-8 h-5 w-5 translate-x-2 -translate-y-2 text-gold opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
          <svg aria-hidden="true" class="h-[2.2rem] w-[2.2rem] text-gold transition duration-400 group-hover:scale-110" viewBox="0 0 24 24"><path d="M9.153 5.408C10.42 3.136 11.053 2 12 2s1.58 1.136 2.847 3.408l.328.588c.36.646.54.969.82 1.182s.63.292 1.33.45l.636.144c2.46.557 3.689.835 3.982 1.776c.292.94-.546 1.921-2.223 3.882l-.434.507c-.476.557-.715.836-.822 1.18c-.107.345-.071.717.001 1.46l.066.677c.253 2.617.38 3.925-.386 4.506s-1.918.051-4.22-1.009l-.597-.274c-.654-.302-.981-.452-1.328-.452s-.674.15-1.328.452l-.596.274c-2.303 1.06-3.455 1.59-4.22 1.01c-.767-.582-.64-1.89-.387-4.507l.066-.676c.072-.744.108-1.116 0-1.46c-.106-.345-.345-.624-.821-1.18l-.434-.508c-1.677-1.96-2.515-2.941-2.223-3.882S3.58 8.328 6.04 7.772l.636-.144c.699-.158 1.048-.237 1.329-.45s.46-.536.82-1.182z" fill="currentColor"/></svg>
          <h3 class="nome-servico mt-8">O completo</h3>
          <p class="mt-3 text-[0.85rem] leading-[1.7] text-mute2">Corte, barbear na navalha, cuidado de barba, limpeza facial e massagem no couro cabeludo.</p>
          <div class="mt-8 flex items-center justify-between border-t border-gold/10 pt-6">
            <span class="font-display text-[1.6rem] leading-[normal] text-gold">R$ 95</span>
            <span class="text-[0.7rem] uppercase tracking-[0.15em] text-mute2">90 min</span>
          </div>
        </article>

        <article class="group relative bg-void px-8 py-12">
          <svg aria-hidden="true" class="absolute right-8 top-8 h-5 w-5 translate-x-2 -translate-y-2 text-gold opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
          <svg aria-hidden="true" class="h-[2.2rem] w-[2.2rem] text-gold transition duration-400 group-hover:scale-110" viewBox="0 0 24 24"><path clip-rule="evenodd" d="M10.847 21.934C5.867 21.362 2 17.133 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10c0 5.157-3.283 4.733-6.086 4.37c-1.618-.209-3.075-.397-3.652.518c-.395.626.032 1.406.555 1.929a1.673 1.673 0 0 1 0 2.366c-.523.523-1.235.836-1.97.751M11.085 7a1.5 1.5 0 1 1-3 0a1.5 1.5 0 0 1 3 0M6.5 13a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3m11 0a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3m-3-4.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3" fill="currentColor" fill-rule="evenodd"/></svg>
          <h3 class="nome-servico mt-8">Design capilar</h3>
          <p class="mt-3 text-[0.85rem] leading-[1.7] text-mute2">Degradês, padrões e desenhos feitos à mão livre na navalha, do risco simples ao gráfico.</p>
          <div class="mt-8 flex items-center justify-between border-t border-gold/10 pt-6">
            <span class="font-display text-[1.6rem] leading-[normal] text-gold">R$ 60</span>
            <span class="text-[0.7rem] uppercase tracking-[0.15em] text-mute2">60 min</span>
          </div>
        </article>

        <article class="group relative bg-void px-8 py-12">
          <svg aria-hidden="true" class="absolute right-8 top-8 h-5 w-5 translate-x-2 -translate-y-2 text-gold opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
          <svg aria-hidden="true" class="h-[2.2rem] w-[2.2rem] text-gold transition duration-400 group-hover:scale-110" viewBox="0 0 24 24"><path clip-rule="evenodd" d="M11.612 22C6.855 22 3 18.057 3 13.193v-.265C3 8.317 5.729 4.163 9.903 2.421a5.43 5.43 0 0 1 4.194 0C18.272 4.163 21 8.317 21 12.928v.265C21 18.057 17.145 22 12.389 22zm.454-16.039a.75.75 0 0 1-.366.996c-1.545.715-2.793 2.168-3.37 3.993a.75.75 0 1 1-1.43-.453c.692-2.186 2.206-3.993 4.17-4.901a.75.75 0 0 1 .996.365" fill="currentColor" fill-rule="evenodd"/></svg>
          <h3 class="nome-servico mt-8">Tratamento capilar</h3>
          <p class="mt-3 text-[0.85rem] leading-[1.7] text-mute2">Esfoliação do couro, óleos essenciais e massagem de relaxamento com pressão firme.</p>
          <div class="mt-8 flex items-center justify-between border-t border-gold/10 pt-6">
            <span class="font-display text-[1.6rem] leading-[normal] text-gold">R$ 70</span>
            <span class="text-[0.7rem] uppercase tracking-[0.15em] text-mute2">45 min</span>
          </div>
        </article>

        <article class="group relative bg-void px-8 py-12">
