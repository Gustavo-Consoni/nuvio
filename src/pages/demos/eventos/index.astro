<script>
  import { aCadaPagina } from "../../../scripts/pagina";
  import { emailValido, esperar, menu, revelar } from "../../../scripts/demos";

  aCadaPagina((signal) => {
    menu(signal, 1024);
    revelar(signal);
    consulta(signal);
  });

  function consulta(signal: AbortSignal) {
    const form = document.querySelector<HTMLFormElement>("[data-consulta]");
    const enviado = document.querySelector<HTMLElement>("[data-enviado]");
    if (!form || !enviado) return;
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const erro = form.querySelector<HTMLElement>("[data-erro]")!;
    const botao = form.querySelector<HTMLButtonElement>("[type=submit]")!;
    const rotulo = form.querySelector<HTMLElement>("[data-rotulo-envio]")!;

    const mostrarErro = (msg: string) => {
      erro.textContent = msg;
      erro.hidden = !msg;
      if (msg) email.setAttribute("aria-invalid", "true");
      else email.removeAttribute("aria-invalid");
    };

    form.addEventListener(
      "submit",
      async (e) => {
        e.preventDefault();
        if (!emailValido(email.value)) return mostrarErro("Confira o e-mail");
        mostrarErro("");
        botao.disabled = true;
        rotulo.textContent = "Enviando…";
        // Demo: o envio é simulado. Num site real, troque a espera por um
        // fetch para Formspree, Web3Forms ou um webhook.
        await esperar(900, signal).catch(() => {});
        if (signal.aborted) return;
        botao.disabled = false;
        rotulo.textContent = "Enviar";
        form.hidden = true;
        enviado.hidden = false;
      },
      { signal },
    );

    enviado.querySelector("[data-novo-pedido]")?.addEventListener(
      "click",
      () => {
        form.reset();
        mostrarErro("");
        enviado.hidden = true;
        form.hidden = false;
      },
      { signal },
    );
  }
</script>
