---
/**
 * Site demo da Casa Vértice, produtora de eventos fictícia. Tema próprio em
 * src/styles/demos/eventos.css (ver src/layouts/DemoSite.astro).
 */
import DemoSite from "../../../layouts/DemoSite.astro";
import "../../../styles/demos/eventos.css";
---

<DemoSite
  title="Direção de eventos de alto padrão"
  marca="Casa Vértice"
  description="Ateliê de produção completa para celebrações privadas, lançamentos de marca e encontros executivos. Do briefing à despedida do último convidado."
  fontes="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&display=swap"
  corTema="#f6f0e8">

  <!-- a folha branca central, com respiro do papel em volta -->
  <main class="relative mx-auto my-0 min-h-screen w-full max-w-[1480px] bg-white sombra-folha md:my-8">

    <!-- ================= BARRA DE TOPO ================= -->
    <div class="hidden border-b border-linha bg-creme lg:block">
      <div class="flex h-10 items-center justify-between gap-6 px-6 text-[10px] uppercase tracking-[0.22em] text-mudo lg:px-12">
        <div class="flex items-center gap-6">
          <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 bg-ouro"></span>São Paulo &middot; Rio &middot; Trancoso</span>
          <span>Celebrações privadas &middot; marca &middot; encontros executivos</span>
        </div>
        <div class="flex items-center gap-6">
          <span>Agenda de 2027 já aberta</span>
          <a href="#contato" class="text-ouro transition duration-300 hover:text-ouro-esc">Consultar disponibilidade</a>
        </div>
      </div>
    </div>

    <!-- ================= HEADER ================= -->
    <header class="sticky top-0 z-50 border-b border-linha bg-folha/90 backdrop-blur-xl">
      <div class="flex h-20 items-center justify-between gap-6 px-6 lg:px-12">
        <a href="#topo" class="flex items-center gap-3 border border-linha bg-folha px-4 py-2.5">
          <span class="grid h-8 w-8 place-items-center bg-ouro text-white">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 15H4l8-15z"/></svg>
          </span>
          <span class="text-xs uppercase tracking-[0.24em] text-tinta">Casa Vértice</span>
        </a>

        <nav class="hidden items-center gap-3 lg:flex">
          <a href="#capacidades" class="link-pilula">Capacidades <span class="text-ouro">↗</span></a>
          <a href="#producoes" class="link-pilula">Produções <span class="text-ouro">↗</span></a>
          <a href="#metodo" class="link-pilula">Método <span class="text-ouro">↗</span></a>
          <a href="#notas" class="link-pilula">Notas <span class="text-ouro">↗</span></a>
        </nav>

        <a href="#contato" class="btn-ouro hidden lg:inline-flex">
          Iniciar um briefing privado
          <span class="btn-ponta">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M4 11h16M5 21h14a1 1 0 001-1V7a1 1 0 00-1-1H5a1 1 0 00-1 1v13a1 1 0 001 1z"/></svg>
          </span>
        </a>

        <button type="button" data-menu-botao aria-controls="menu-mobile" aria-expanded="false" aria-label="Abrir menu"
                class="group grid h-10 w-10 cursor-pointer place-items-center border border-linha text-tinta lg:hidden">
          <svg class="h-4 w-4 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="hidden h-4 w-4 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <div id="menu-mobile" class="recolhe lg:hidden">
        <div>
        <div class="space-y-1 border-t border-linha px-6 py-5">
          <a href="#capacidades" class="block py-2.5 text-xs uppercase tracking-[0.2em] text-mudo hover:text-ouro">Capacidades</a>
          <a href="#producoes" class="block py-2.5 text-xs uppercase tracking-[0.2em] text-mudo hover:text-ouro">Produções</a>
          <a href="#metodo" class="block py-2.5 text-xs uppercase tracking-[0.2em] text-mudo hover:text-ouro">Método</a>
          <a href="#notas" class="block py-2.5 text-xs uppercase tracking-[0.2em] text-mudo hover:text-ouro">Notas</a>
          <a href="#contato" class="btn-ouro mt-3 !pr-1">Iniciar um briefing privado<span class="btn-ponta">→</span></a>
        </div>
        </div>
      </div>
    </header>

    <!-- ================= HERO ================= -->
    <section id="topo" class="relative overflow-hidden px-6 py-12 lg:px-12 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:gap-10">

        <div class="max-w-3xl">
          <p class="flex items-center gap-3 text-[10px] uppercase tracking-[0.24em] text-mudo">
            <span class="h-2 w-2 bg-ouro"></span>Direção de eventos de alto padrão
          </p>

          <h1 class="mt-8 text-[2.2rem] font-extralight uppercase leading-[1.05] tracking-[-0.01em] text-tinta sm:text-5xl lg:text-[4.2rem]">
            Eventos curados<br />para marcas, líderes<br />e círculos privados
          </h1>

          <div class="mt-10 flex items-center gap-5">
            <span class="grid h-14 w-14 shrink-0 place-items-center bg-ouro/15 text-ouro">
              <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 15H4l8-15zM8.5 18l3.5-6.5L15.5 18"/></svg>
            </span>
            <p class="text-xs uppercase tracking-[0.24em] text-ouro">Ateliê de produção completa</p>
          </div>

          <p class="mt-10 max-w-lg text-[15px] leading-relaxed text-mudo">
            Planejamos e produzimos encontros com a precisão de uma central de comando
            e o cuidado de uma casa particular. O convidado só percebe o resultado.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-8">
            <a href="#contato" class="btn-escuro">
              Planejar o momento
              <span class="btn-ponta">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </span>
            </a>
            <ul class="flex flex-wrap items-center gap-6 text-[10px] uppercase tracking-[0.22em] text-mudo">
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 bg-ouro"></span>Estratégia</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 bg-ouro"></span>Design</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 bg-ouro"></span>Produção</li>
            </ul>
          </div>

          <dl class="mt-12 grid max-w-xl grid-cols-3 border-t border-linha">
            <div class="border-r border-linha py-7 pr-6">
              <dt class="sr-only">Eventos dirigidos</dt>
              <dd class="text-3xl font-extralight text-tinta">140<span class="text-ouro">+</span></dd>
              <p class="mt-2 text-[10px] uppercase tracking-[0.2em] text-mudo">Eventos dirigidos</p>
            </div>
            <div class="border-r border-linha px-6 py-7">
              <dt class="sr-only">Cidades atendidas</dt>
              <dd class="text-3xl font-extralight text-tinta">12</dd>
              <p class="mt-2 text-[10px] uppercase tracking-[0.2em] text-mudo">Cidades atendidas</p>
            </div>
            <div class="px-6 py-7">
              <dt class="sr-only">Universos de evento</dt>
              <dd class="text-3xl font-extralight text-tinta">3</dd>
              <p class="mt-2 text-[10px] uppercase tracking-[0.2em] text-mudo">Universos de evento</p>
            </div>
          </dl>
        </div>

        <!-- tríptico escalonado, como na referência -->
        <div class="flex h-[420px] items-start gap-3 sm:h-[540px] lg:h-[760px] lg:w-[520px]">
          <div class="painel mt-[18%] h-[62%] w-1/3 sombra-folha">
            <img src="/demos/eventos/static/images/hero-salao.webp" alt="Salão privado montado para um jantar" width="420" height="1180" decoding="async" fetchpriority="high" />
            <div class="absolute inset-x-0 bottom-0 p-4">
              <p class="text-[9px] uppercase tracking-[0.2em] text-white/70">01 / Privado</p>
              <p class="mt-1.5 text-sm font-light text-white">Salão privado</p>
            </div>
          </div>

          <div class="painel h-[92%] w-1/3 sombra-funda">
            <img src="/demos/eventos/static/images/hero-gala.webp" alt="Gala sob um lustre de cristal" width="420" height="1180" decoding="async" fetchpriority="high" />
            <div class="absolute inset-x-0 bottom-0 p-4">
              <p class="text-[9px] uppercase tracking-[0.2em] text-white/70">02 / Gala</p>
              <p class="mt-1.5 text-sm font-light text-white">Gala beneficente</p>
              <p class="mt-2 hidden text-[11px] leading-relaxed text-white/70 sm:block">Produção multiambiente, mesas editoriais e transição de convidados controlada.</p>
            </div>
          </div>

          <div class="painel mt-[30%] h-[70%] w-1/3 sombra-folha">
            <img src="/demos/eventos/static/images/hero-marca.webp" alt="Lançamento de marca com convidados no ambiente" width="420" height="1180" decoding="async" fetchpriority="high" />
            <div class="absolute inset-x-0 bottom-0 p-4">
              <p class="text-[9px] uppercase tracking-[0.2em] text-white/70">03 / Marca</p>
              <p class="mt-1.5 text-sm font-light text-white">Lançamento de marca</p>
            </div>
          </div>
        </div>
      </div>

      <!-- três passos, embaixo do hero -->
      <div class="mt-16 grid gap-4 sm:grid-cols-3">
        <article class="group border border-linha bg-creme p-6 transition duration-300 hover:border-ouro">
          <p class="text-[10px] uppercase tracking-[0.22em] text-ouro">01 / Briefing</p>
          <h2 class="mt-5 text-lg font-light text-tinta">Briefing estratégico</h2>
          <p class="mt-3 text-sm leading-relaxed text-mudo">Propósito, perfil do convidado, jornada e o conceito do encontro.</p>
        </article>
        <article class="group border border-linha bg-creme p-6 transition duration-300 hover:border-ouro">
          <p class="text-[10px] uppercase tracking-[0.22em] text-ouro">02 / Atmosfera</p>
          <h2 class="mt-5 text-lg font-light text-tinta">Direção de atmosfera</h2>
          <p class="mt-3 text-sm leading-relaxed text-mudo">Linguagem visual, luz, som, sinais de serviço e detalhes sensoriais.</p>
        </article>
        <article class="group border border-linha bg-creme p-6 transition duration-300 hover:border-ouro">
          <p class="text-[10px] uppercase tracking-[0.22em] text-ouro">03 / Comando</p>
          <h2 class="mt-5 text-lg font-light text-tinta">Produção ao vivo</h2>
          <p class="mt-3 text-sm leading-relaxed text-mudo">Fornecedores, logística, timing e a equipe de comando no local.</p>
        </article>
      </div>
    </section>

    <!-- ================= MARQUEE ================= -->
    <section class="bg-white py-10 md:py-12" aria-label="O que fazemos">
      <div class="overflow-hidden border-y border-linha bg-creme">
        <div class="marquee flex w-max py-4 text-[10px] uppercase tracking-[0.28em] text-mudo">
          <div class="flex shrink-0 items-center">
            <span class="px-8">Mapa da jornada do convidado</span><span class="text-ouro">◆</span>
            <span class="px-8">Transformação de espaço</span><span class="text-ouro">◆</span>
            <span class="px-8">Direção gastronômica</span><span class="text-ouro">◆</span>
            <span class="px-8">Comando de produção</span><span class="text-ouro">◆</span>
            <span class="px-8">Design de atmosfera</span><span class="text-ouro">◆</span>
          </div>
          <div class="flex shrink-0 items-center" aria-hidden="true">
            <span class="px-8">Mapa da jornada do convidado</span><span class="text-ouro">◆</span>
            <span class="px-8">Transformação de espaço</span><span class="text-ouro">◆</span>
            <span class="px-8">Direção gastronômica</span><span class="text-ouro">◆</span>
            <span class="px-8">Comando de produção</span><span class="text-ouro">◆</span>
            <span class="px-8">Design de atmosfera</span><span class="text-ouro">◆</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CAPACIDADES ================= -->
    <section id="capacidades" class="bg-white px-6 py-24 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="text-center rv" data-revelar>
          <p class="selo">/ Capacidades /</p>
          <h2 class="titulo mt-6">Planejamento completo para<br /><em>momentos decisivos</em></h2>
        </div>

        <div class="mt-16 grid gap-6 lg:grid-cols-2">
          <article class="relative border border-linha bg-creme p-8 sm:p-10 rv" data-revelar>
            <div class="quadriculado pointer-events-none absolute inset-0 opacity-60"></div>
            <div class="relative">
              <div class="flex items-start justify-between gap-6 text-[10px] uppercase tracking-[0.22em]">
                <span class="text-ouro">01 / Privado</span>
                <span class="text-mudo">Escala íntima</span>
              </div>
              <h3 class="mt-10 text-2xl font-light text-tinta sm:text-3xl">Celebrações privadas</h3>
              <p class="mt-5 text-sm leading-relaxed text-mudo">
                Encontros íntimos conduzidos com plano de produção de evento grande.
                Cada detalhe é desenhado em torno do fluxo dos convidados, do tempo
                de serviço e da lembrança que fica.
              </p>
              <ul class="mt-8 grid gap-3 text-sm text-tinta sm:grid-cols-2">
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Jantares e salões privados</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Celebrações de marco</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Fins de semana em destino</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Hospitalidade sob medida</li>
              </ul>
            </div>
          </article>

          <article class="bg-tinta p-8 text-white sm:p-10 rv" data-revelar data-atraso="110">
            <div class="flex items-start justify-between gap-6 text-[10px] uppercase tracking-[0.22em]">
              <span class="text-ouro">02 / Marca</span>
              <span class="text-suave">Momentos públicos</span>
            </div>
            <h3 class="mt-10 text-2xl font-light sm:text-3xl">Momentos de marca e cultura</h3>
            <p class="mt-5 text-sm leading-relaxed text-suave">
              Lançamentos, prévias de imprensa e experiências culturais construídos para
              parecerem cinema: controlados por dentro, memoráveis por fora. A estratégia
              vira ambiente, ritual e ritmo.
            </p>
            <ul class="mt-8 grid gap-3 text-sm sm:grid-cols-2">
              <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Lançamento de produto</li>
              <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Prévia de imprensa e VIP</li>
              <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Salões culturais</li>
              <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ouro"></span>Hospitalidade premium</li>
            </ul>
          </article>
        </div>

        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <article class="painel min-h-[340px] sombra-funda rv" data-revelar>
            <img src="/demos/eventos/static/images/cupula.webp" alt="Sala de reunião executiva com vista para a serra" width="810" height="720" loading="lazy" decoding="async" />
            <div class="absolute inset-x-0 bottom-0 p-7">
              <p class="text-[10px] uppercase tracking-[0.22em] text-white/70">Executivo</p>
              <h3 class="mt-2 text-xl font-light text-white">Cúpulas de liderança</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/70">Encontros fechados de conselho e diretoria, com agenda e logística sob controle.</p>
            </div>
          </article>
          <article class="painel min-h-[340px] sombra-funda rv" data-revelar data-atraso="110">
            <img src="/demos/eventos/static/images/hospitalidade.webp" alt="Convidados circulando entre arranjos de flores" width="810" height="720" loading="lazy" decoding="async" />
            <div class="absolute inset-x-0 bottom-0 p-7">
              <p class="text-[10px] uppercase tracking-[0.22em] text-white/70">Hospitalidade</p>
              <h3 class="mt-2 text-xl font-light text-white">Experiência do convidado</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/70">Da chegada ao carro de volta: cada ponto de contato tem alguém responsável.</p>
            </div>
          </article>
          <article class="painel min-h-[340px] sombra-funda rv sm:col-span-2 lg:col-span-1" data-revelar data-atraso="220">
            <img src="/demos/eventos/static/images/gastronomia.webp" alt="Prato sendo servido em mesa posta com cristais" width="810" height="720" loading="lazy" decoding="async" />
            <div class="absolute inset-x-0 bottom-0 p-7">
              <p class="text-[10px] uppercase tracking-[0.22em] text-white/70">Gastronomia</p>
              <h3 class="mt-2 text-xl font-light text-white">Design de mesa e serviço</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/70">Menu, tempo de cada prato e desenho de mesa pensados como uma coisa só.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= PRODUÇÕES ================= -->
    <section id="producoes" class="bg-creme px-6 py-24 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="text-center rv" data-revelar>
          <p class="selo">/ Produções recentes /</p>
          <h2 class="titulo mt-6">Produções curadas<br /><em>universos de evento</em></h2>
        </div>

        <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

          <article class="border border-linha bg-folha p-5 rv" data-revelar>
            <div class="painel relative h-56">
              <img src="/demos/eventos/static/images/prod-1.webp" alt="Jantar de lançamento em galeria" width="540" height="450" loading="lazy" decoding="async" />
              <span class="absolute right-3 top-3 z-10 bg-folha px-2 py-1 text-[10px] tracking-[0.14em] text-tinta">01 / 04</span>
            </div>
            <p class="mt-5 text-[10px] uppercase tracking-[0.22em] text-ouro">Lançamento de marca</p>
            <h3 class="mt-2 text-xl font-light text-tinta">Casa Aurora</h3>
            <p class="mt-1.5 text-sm text-mudo">Jantar de coleção &middot; São Paulo</p>
            <dl class="mt-5 grid grid-cols-3 gap-2 border-t border-linha pt-4 text-[10px] uppercase tracking-[0.16em] text-mudo">
              <div><dt>Convidados</dt><dd class="mt-1.5 text-sm normal-case tracking-normal text-tinta">180</dd></div>
              <div><dt>Ambientes</dt><dd class="mt-1.5 text-sm normal-case tracking-normal text-tinta">04</dd></div>
              <div><dt>Prazo</dt><dd class="mt-1.5 text-sm normal-case tracking-normal text-tinta">10 sem</dd></div>
            </dl>
            <div class="mt-5 flex items-center justify-between border-t border-linha pt-4">
              <span class="text-[10px] uppercase tracking-[0.2em] text-mudo">Prévia de imprensa</span>
              <span class="grid h-8 w-8 place-items-center border border-linha text-ouro">→</span>
            </div>
          </article>

          <article class="bg-tinta p-5 text-white rv" data-revelar data-atraso="90">
            <div class="painel relative h-56">
              <img src="/demos/eventos/static/images/prod-2.webp" alt="Gala beneficente em salão iluminado" width="540" height="450" loading="lazy" decoding="async" />
              <span class="absolute right-3 top-3 z-10 bg-folha px-2 py-1 text-[10px] tracking-[0.14em] text-tinta">02 / 04</span>
            </div>
            <p class="mt-5 text-[10px] uppercase tracking-[0.22em] text-ouro">Gala beneficente</p>
            <h3 class="mt-2 text-xl font-light">Noite do Instituto</h3>
            <p class="mt-1.5 text-sm text-suave">Jantar de arrecadação &middot; Rio de Janeiro</p>
            <dl class="mt-5 grid grid-cols-3 gap-2 border-t border-white/15 pt-4 text-[10px] uppercase tracking-[0.16em] text-suave">
              <div><dt>Convidados</dt><dd class="mt-1.5 text-sm normal-case tracking-normal text-white">420</dd></div>
              <div><dt>Atos</dt><dd class="mt-1.5 text-sm normal-case tracking-normal text-white">03</dd></div>
              <div><dt>Prazo</dt><dd class="mt-1.5 text-sm normal-case tracking-normal text-white">16 sem</dd></div>
            </dl>
            <div class="mt-5 flex items-center justify-between border-t border-white/15 pt-4">
              <span class="text-[10px] uppercase tracking-[0.2em] text-suave">Noite de arrecadação</span>
              <span class="grid h-8 w-8 place-items-center border border-white/20 text-ouro">→</span>
            </div>
          </article>

          <article class="bg-tinta p-5 text-white rv" data-revelar data-atraso="180">
            <div class="painel relative h-56">
              <img src="/demos/eventos/static/images/prod-3.webp" alt="Mesa posta à beira do lago no fim da tarde" width="540" height="450" loading="lazy" decoding="async" />
              <span class="absolute right-3 top-3 z-10 bg-folha px-2 py-1 text-[10px] tracking-[0.14em] text-tinta">03 / 04</span>
            </div>
            <p class="mt-5 text-[10px] uppercase tracking-[0.22em] text-ouro">Salão privado</p>
            <h3 class="mt-2 text-xl font-light">Casa da Represa</h3>
            <p class="mt-1.5 text-sm text-suave">Fim de semana privado &middot; Trancoso</p>
            <dl class="mt-5 grid grid-cols-3 gap-2 border-t border-white/15 pt-4 text-[10px] uppercase tracking-[0.16em] text-suave">
