---
/**
 * Site demo da Mesa Farta, blog de receitas fictício. Tema próprio em
 * src/styles/demos/restaurante.css (ver src/layouts/DemoSite.astro).
 */
import DemoSite from "../../../layouts/DemoSite.astro";
import "../../../styles/demos/restaurante.css";
---

<DemoSite
  title="Receitas de verdade para a cozinha de casa"
  marca="Mesa Farta"
  description="Receitas testadas, ingredientes da estação e técnica explicada sem enrolação. Um cardápio novo toda semana, direto no seu e-mail."
  fontes="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Geist+Mono:wght@400;500;600&display=swap"
  corTema="#faf9f6">

  <!-- ================= HEADER ================= -->
  <header class="fixed inset-x-0 top-4 z-50 px-5 sm:px-8">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 rounded-full border border-line bg-white/90 py-2.5 pl-3 pr-2.5 shadow-lg shadow-ink/5 backdrop-blur-md">
      <a href="#topo" class="flex shrink-0 items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-deep font-serif text-lg italic text-white">M</span>
        <span class="text-[15px] font-extrabold tracking-tight text-deep">Mesa Farta</span>
      </a>

      <nav class="hidden items-center rounded-full bg-cloud/60 p-1 shadow-sm shadow-ink/5 lg:flex">
        <a href="#receitas" class="link-nav">Receitas</a>
        <a href="#chef" class="link-nav">A cozinha</a>
        <a href="#mundo" class="link-nav">Sabores</a>
        <a href="#clube" class="link-nav">Clube</a>
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <button type="button" data-busca-botao aria-expanded="false" aria-controls="busca" aria-label="Buscar receita"
                class="grid h-10 w-10 cursor-pointer place-items-center rounded-full text-mute transition duration-300 hover:bg-cloud hover:text-deep">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
        </button>
        <a href="#clube" class="btn-noite hidden sm:inline-flex">Inscrever-se</a>
        <button type="button" data-menu-botao aria-controls="menu-mobile" aria-expanded="false" aria-label="Abrir menu"
                class="group grid h-10 w-10 cursor-pointer place-items-center rounded-full border border-line text-deep lg:hidden">
          <svg class="h-4 w-4 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="hidden h-4 w-4 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>

    <div id="menu-mobile" class="recolhe lg:hidden">
      <div>
      <div class="mx-auto mt-2 max-w-5xl rounded-3xl border border-line bg-white p-3 shadow-lg shadow-ink/5">
        <a href="#receitas" class="block rounded-2xl px-4 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-mute hover:bg-cloud hover:text-deep">Receitas</a>
        <a href="#chef" class="block rounded-2xl px-4 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-mute hover:bg-cloud hover:text-deep">A cozinha</a>
        <a href="#mundo" class="block rounded-2xl px-4 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-mute hover:bg-cloud hover:text-deep">Sabores</a>
        <a href="#clube" class="block rounded-2xl px-4 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-mute hover:bg-cloud hover:text-deep">Clube</a>
        <a href="#clube" class="btn-noite mt-2 w-full">Inscrever-se</a>
      </div>
      </div>
    </div>

    <div id="busca" class="recolhe">
      <div>
      <div class="mx-auto mt-2 max-w-5xl rounded-3xl border border-line bg-white p-3 shadow-lg shadow-ink/5">
        <label for="termo" class="sr-only">Buscar receita</label>
        <input id="termo" type="search"
               placeholder="Buscar receita: massa, salada, chocolate…" class="campo" />
      </div>
      </div>
    </div>
  </header>

  <!-- ================= HERO ================= -->
  <section id="topo" class="px-5 pt-28 sm:px-8 lg:pt-32">
    <div class="mx-auto grid max-w-[1440px] gap-4 lg:grid-cols-[1.55fr_1fr]">

      <!-- cartão grande -->
      <article class="relative overflow-hidden rounded-bento bg-deep">
        <img src="/demos/restaurante/static/images/hero-capa.webp" alt="Prato de sopa rústica com pão artesanal" width="1000" height="935"
             decoding="async" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
        <!-- o título branco cai em cima da parte clara da foto: sem este degradê
             mais forte (como o from-black/60 da referência) o contraste não fecha -->
        <div class="absolute inset-0 bg-gradient-to-t from-deep/95 via-deep/80 via-45% to-transparent"></div>

        <div class="relative flex min-h-[460px] flex-col justify-end p-7 sm:min-h-[560px] sm:p-10 lg:min-h-[620px]">
          <div class="flex flex-wrap items-center gap-3">
            <span class="pilula">Escolha da casa</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/70">Preparo 40 min</span>
          </div>

          <h1 class="display mt-5 text-4xl leading-none !text-white sm:text-[3.75rem] lg:text-[4.5rem]">
            Cozinhar bem é<br /><em>mais simples do que contam</em>
          </h1>

          <div class="mt-7 border-t border-white/20 pt-6 sm:flex sm:items-end sm:justify-between sm:gap-8">
            <p class="max-w-md text-[15px] leading-relaxed text-white/75">
              Receitas testadas até dar certo, ingredientes que existem na feira e o
              porquê de cada passo. Sem lista de 30 itens que você usa uma vez só.
            </p>
            <a href="#receitas" aria-label="Ver as receitas"
               class="mt-6 grid h-12 w-12 shrink-0 cursor-pointer place-items-center rounded-full bg-white text-deep transition duration-300 hover:bg-rose hover:text-white sm:mt-0">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9m8 0v8"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- coluna de dois cartões -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        <article class="relative overflow-hidden rounded-bento border border-line bg-white">
          <img src="/demos/restaurante/static/images/ervas.webp" alt="Ervas frescas dispostas em um prato" width="600" height="556"
               loading="lazy" decoding="async" class="h-full min-h-[220px] w-full object-cover" />
          <div class="absolute left-6 right-6 top-6">
            <span class="block font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-mute">Da estação</span>
            <h2 class="mt-1.5 max-w-[15rem] font-serif text-2xl leading-tight text-ink">Ervas frescas da estação</h2>
          </div>
          <div class="absolute bottom-4 left-4 flex items-center gap-3 rounded-full bg-white/90 p-1.5 pr-4 backdrop-blur">
            <img src="/demos/restaurante/static/images/chef-avatar.webp" alt="" width="120" height="120" loading="lazy" class="h-9 w-9 rounded-full object-cover" />
            <div class="leading-tight">
              <p class="text-xs font-bold text-deep">Chef Helena</p>
              <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-mute2">Colheita da semana</p>
            </div>
          </div>
        </article>

        <article class="group relative overflow-hidden rounded-bento bg-deep">
          <img src="/demos/restaurante/static/images/chef-card.webp" alt="Helena na cozinha do restaurante" width="600" height="560"
               loading="lazy" decoding="async" class="h-full min-h-[220px] w-full object-cover grayscale transition duration-300 group-hover:grayscale-0" />
          <div class="absolute inset-0 bg-gradient-to-t from-deep/85 to-transparent"></div>
          <div class="absolute inset-x-4 bottom-4 rounded-2xl bg-white/10 p-4 backdrop-blur">
            <p class="text-[15px] font-bold text-white">As 5 facas que bastam</p>
            <a href="#receitas" class="mt-1.5 inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-white/80 transition duration-300 hover:text-white">
              Ler o guia
              <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <section class="mt-6 overflow-hidden border-y border-line py-5">
    <div class="marquee flex w-max items-center gap-10">
      <div class="flex shrink-0 items-center gap-10">
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Ingredientes da estação</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Técnica explicada</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Feira antes do mercado</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Menos louça suja</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Sobra que vira almoço</span>
      </div>
      <div class="flex shrink-0 items-center gap-10" aria-hidden="true">
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Ingredientes da estação</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Técnica explicada</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Feira antes do mercado</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Menos louça suja</span>
        <span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute2"><span class="text-rose">✦</span> Sobra que vira almoço</span>
      </div>
    </div>
  </section>

  <!-- ================= RECEITAS ================= -->
  <section id="receitas" class="py-20 lg:py-28">
    <div class="wrap">
      <div class="flex items-end justify-between gap-8">
        <div class="rv" data-revelar>
          <h2 class="display text-4xl italic text-ink">Direto da cozinha</h2>
          <p class="meta mt-3">Novas receitas para testar esta semana</p>
        </div>
        <div class="hidden shrink-0 gap-2 sm:flex">
          <button type="button" data-rolar="-1" aria-label="Anterior" disabled
                  class="grid h-11 w-11 cursor-pointer place-items-center rounded-full border border-line bg-white text-deep transition duration-300 hover:border-mute2 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-line">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button type="button" data-rolar="1" aria-label="Próximo" disabled
                  class="grid h-11 w-11 cursor-pointer place-items-center rounded-full border border-line bg-white text-deep transition duration-300 hover:border-mute2 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-line">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <div data-trilho class="mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">

        <article class="group w-[74vw] shrink-0 snap-start sm:w-[46vw] lg:w-[calc((100%-3.75rem)/4)]">
          <div class="relative overflow-hidden rounded-2xl bg-cloud">
            <img src="/demos/restaurante/static/images/receita-1.webp" alt="Massa artesanal com molho de tomate e manjericão" width="500" height="667"
                 loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
            <span class="pilula absolute left-3 top-3">Jantar</span>
          </div>
          <h3 class="mt-4 text-[17px] font-bold leading-snug text-deep">Massa fresca com tomate e manjericão</h3>
          <p class="meta mt-1.5">45 min &middot; Intermediário</p>
        </article>

        <article class="group w-[74vw] shrink-0 snap-start sm:w-[46vw] lg:w-[calc((100%-3.75rem)/4)]">
          <div class="relative overflow-hidden rounded-2xl bg-cloud">
            <img src="/demos/restaurante/static/images/receita-2.webp" alt="Salada colorida com tomates e flores comestíveis" width="500" height="667"
                 loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
            <span class="pilula absolute left-3 top-3">Leve</span>
          </div>
          <h3 class="mt-4 text-[17px] font-bold leading-snug text-deep">Salada de verão com cítricos e ervas</h3>
          <p class="meta mt-1.5">15 min &middot; Fácil</p>
        </article>

        <article class="group w-[74vw] shrink-0 snap-start sm:w-[46vw] lg:w-[calc((100%-3.75rem)/4)]">
          <div class="relative overflow-hidden rounded-2xl bg-cloud">
            <img src="/demos/restaurante/static/images/receita-3.webp" alt="Doces variados vistos de cima" width="500" height="667"
                 loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
            <span class="pilula absolute left-3 top-3">Doce</span>
          </div>
          <h3 class="mt-4 text-[17px] font-bold leading-snug text-deep">Torta de chocolate meio amargo</h3>
          <p class="meta mt-1.5">60 min &middot; Difícil</p>
        </article>

        <article class="group w-[74vw] shrink-0 snap-start sm:w-[46vw] lg:w-[calc((100%-3.75rem)/4)]">
          <div class="relative overflow-hidden rounded-2xl bg-cloud">
            <img src="/demos/restaurante/static/images/receita-4.webp" alt="Costela assada em tábua de madeira" width="500" height="667"
                 loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
            <span class="pilula absolute left-3 top-3">Domingo</span>
          </div>
          <h3 class="mt-4 text-[17px] font-bold leading-snug text-deep">Costela lenta com melado e alho</h3>
          <p class="meta mt-1.5">3 horas &middot; Fácil</p>
        </article>

      </div>

      <p data-vazio hidden class="mt-4 text-[15px] text-mute">
        Nenhuma receita com esse nome por aqui. Tente <button type="button" data-limpar-busca class="cursor-pointer text-rose underline underline-offset-4">limpar a busca</button>.
      </p>
    </div>
  </section>

  <!-- ================= A COZINHA ================= -->
  <section id="chef" class="pb-20 lg:pb-28">
    <div class="wrap">
      <div class="grid overflow-hidden rounded-painel border border-line bg-white lg:grid-cols-2">

        <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-16">
          <svg aria-hidden="true" class="h-11 w-11 text-rose opacity-25" viewBox="0 0 24 24"><g fill="currentColor"><path d="M7 5C4.23858 5 2 7.23858 2 10C2 12.0503 3.2341 13.8124 5 14.584V17.25H19L19 14.584C20.7659 13.8124 22 12.0503 22 10C22 7.23858 19.7614 5 17 5C16.7495 5 16.5033 5.01842 16.2626 5.05399C15.6604 3.27806 13.9794 2 12 2C10.0206 2 8.33961 3.27806 7.73736 5.05399C7.49673 5.01842 7.25052 5 7 5Z"/><path d="M18.9983 18.75H5.00169C5.01188 20.1469 5.08343 20.9119 5.58579 21.4142C6.17157 22 7.11438 22 9 22H15C16.8856 22 17.8284 22 18.4142 21.4142C18.9166 20.9119 18.9881 20.1469 18.9983 18.75Z"/></g></svg>
          <h2 class="display mt-7 text-3xl sm:text-4xl lg:text-5xl">
            Sem mistério.<br /><em class="text-mute2">Sou a Helena.</em>
          </h2>
          <p class="mt-6 text-[15px] leading-relaxed text-mute">
            Cozinho há quinze anos, sendo os últimos seis numa cozinha de restaurante
            e o resto na minha, que é bem menor e tem uma boca de fogão que não acende.
            É de lá que saem quase todas as receitas daqui.
          </p>
          <p class="mt-4 text-[15px] leading-relaxed text-mute">
            Meu critério é simples: se não der para repetir numa terça-feira à noite,
            depois do trabalho, não entra no site.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#receitas" class="btn-escuro !rounded-xl">Ver as receitas</a>
            <a href="#clube" class="btn-claro !rounded-xl">Aulas ao vivo</a>
          </div>

          <div class="mt-10 grid grid-cols-3 gap-6 border-t border-line pt-8">
            <div>
              <p class="font-serif text-3xl text-deep">240</p>
              <p class="meta mt-1">Receitas testadas</p>
            </div>
            <div>
              <p class="font-serif text-3xl text-deep">15</p>
              <p class="meta mt-1">Anos de cozinha</p>
            </div>
            <div>
              <p class="font-serif text-3xl text-deep">86k</p>
              <p class="meta mt-1">Inscritos</p>
            </div>
          </div>
        </div>

        <div class="relative min-h-[340px] lg:min-h-full">
          <img src="/demos/restaurante/static/images/chef-perfil.webp" alt="Helena na cozinha" width="700" height="745"
               loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute bottom-6 right-6 max-w-xs rounded-2xl bg-white/80 p-4 shadow-lg backdrop-blur-md">
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
              <span class="meta !text-deep">Abrindo massa agora</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SABORES DO MUNDO ================= -->
  <section id="mundo" class="pb-20 lg:pb-28">
    <div class="wrap grid items-center gap-10 lg:grid-cols-[1fr_1.5fr] lg:gap-16">

      <div class="rv" data-revelar>
        <h2 class="display text-3xl sm:text-4xl">Sabores do mundo</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-mute">
          Toda semana a gente puxa uma linha de uma cozinha diferente e adapta para
          o que existe no mercado aqui.
        </p>

        <ul class="mt-9">
          <li><button type="button" data-cozinha="0" aria-pressed="true" class="flex w-full cursor-pointer items-center justify-between gap-4 border-b border-line py-4 text-left text-mute2 transition duration-300 hover:text-deep aria-pressed:text-deep">
            <span class="text-sm font-bold uppercase tracking-[0.1em]">01. Italiana</span>
            <span class="rotulo-cozinha font-mono text-[10px] uppercase tracking-[0.1em]">Massas e risotos</span>
          </button></li>
          <li><button type="button" data-cozinha="1" aria-pressed="false" class="flex w-full cursor-pointer items-center justify-between gap-4 border-b border-line py-4 text-left text-mute2 transition duration-300 hover:text-deep aria-pressed:text-deep">
            <span class="text-sm font-bold uppercase tracking-[0.1em]">02. Asiática</span>
            <span class="rotulo-cozinha font-mono text-[10px] uppercase tracking-[0.1em]">Wok e caldos</span>
          </button></li>
          <li><button type="button" data-cozinha="2" aria-pressed="false" class="flex w-full cursor-pointer items-center justify-between gap-4 border-b border-line py-4 text-left text-mute2 transition duration-300 hover:text-deep aria-pressed:text-deep">
            <span class="text-sm font-bold uppercase tracking-[0.1em]">03. Francesa</span>
            <span class="rotulo-cozinha font-mono text-[10px] uppercase tracking-[0.1em]">Molhos e massas doces</span>
          </button></li>
          <li><button type="button" data-cozinha="3" aria-pressed="false" class="flex w-full cursor-pointer items-center justify-between gap-4 border-b border-line py-4 text-left text-mute2 transition duration-300 hover:text-deep aria-pressed:text-deep">
            <span class="text-sm font-bold uppercase tracking-[0.1em]">04. Brasileira</span>
            <span class="rotulo-cozinha font-mono text-[10px] uppercase tracking-[0.1em]">Raiz e regionais</span>
          </button></li>
        </ul>
      </div>

      <div class="relative overflow-hidden rounded-mapa bg-deep p-6 sm:p-10">
        <img src="/demos/restaurante/static/images/mapa.svg" alt="Mapa-múndi com as cozinhas em destaque" width="811" height="529"
             loading="lazy" decoding="async" class="w-full opacity-25 invert" />

        <!-- pinos posicionados em porcentagem sobre o mapa -->
        <div data-pino="0" data-ativo class="group absolute left-[47%] top-[38%] -translate-x-1/2">
          <!-- cartão do pino: a referência mostra uma miniatura acima do ponto -->
          <div class="pino-cartao absolute bottom-full left-1/2 mb-3 w-[8.75rem] -translate-x-1/2 rounded-lg bg-white p-2 shadow-lg">
            <img src="/demos/restaurante/static/images/pino-1.webp" alt="" width="160" height="160" decoding="async"
                 class="h-16 w-full rounded-md object-cover" />
            <p class="mt-2 text-center font-mono text-[10px] uppercase tracking-[0.1em] text-deep">Pasta fresca</p>
          </div>
          <span class="block h-3 w-3 rounded-full bg-white/50 ring-4 ring-white/10 transition duration-300 group-data-ativo:bg-rose group-data-ativo:ring-rose/25"></span>
        </div>
        <div data-pino="1" class="group absolute left-[72%] top-[44%] -translate-x-1/2">
          <!-- cartão do pino: a referência mostra uma miniatura acima do ponto -->
