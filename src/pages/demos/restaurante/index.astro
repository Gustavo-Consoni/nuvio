<script>
  import { aCadaPagina } from "../../../scripts/pagina";
  import { alternar, emailValido, menu, revelar } from "../../../scripts/demos";

  aCadaPagina((signal) => {
    menu(signal, 1024);
    revelar(signal);
    receitas(signal);
    cozinhas(signal);
    clube(signal);
  });

  /** Carrossel de receitas e a busca do topo, que filtra os cards dele. */
  function receitas(signal: AbortSignal) {
    const trilho = document.querySelector<HTMLElement>("[data-trilho]");
    const botaoBusca = document.querySelector<HTMLElement>("[data-busca-botao]");
    const termo = document.querySelector<HTMLInputElement>("#termo");
    const vazio = document.querySelector<HTMLElement>("[data-vazio]");
    if (!trilho || !botaoBusca || !termo || !vazio) return;
    const cards = [...trilho.querySelectorAll<HTMLElement>("article")];
    const setas = document.querySelectorAll<HTMLButtonElement>("[data-rolar]");

    // Em telas largas os 4 cards cabem inteiros: aí não há o que rolar e as
    // setas ficam desabilitadas em vez de mortas.
    const medir = () => {
      const folga = trilho.scrollWidth > trilho.clientWidth + 4;
      setas.forEach((b) => (b.disabled = !folga));
    };

    // Lê o texto do próprio card em vez de repetir o título aqui: o conteúdo
    // continua morando só no HTML.
    const filtrar = () => {
      const t = termo.value.trim().toLowerCase();
      cards.forEach((c) => (c.hidden = !!t && !c.textContent!.toLowerCase().includes(t)));
      vazio.hidden = cards.some((c) => !c.hidden);
      medir();
    };
    const limpar = () => {
      termo.value = "";
      filtrar();
    };

    const abrirBusca = alternar(botaoBusca, signal, {
      aoMudar: (aberta) => (aberta ? termo.focus() : limpar()),
    });
    termo.addEventListener("input", filtrar, { signal });
    termo.addEventListener("keydown", (e) => e.key === "Escape" && abrirBusca(false), { signal });
    vazio.querySelector("[data-limpar-busca]")?.addEventListener("click", limpar, { signal });

    setas.forEach((b) =>
      b.addEventListener(
        "click",
        () => {
          const card = cards.find((c) => !c.hidden);
          const passo = card ? card.getBoundingClientRect().width + 20 : trilho.clientWidth * 0.8;
          trilho.scrollBy({ left: Number(b.dataset.rolar) * passo, behavior: "smooth" });
        },
        { signal },
      ),
    );

    medir();
    window.addEventListener("resize", medir, { signal });
    // as imagens podem mudar a largura dos cards ao carregar
    window.addEventListener("load", medir, { signal });
  }

  /** "Sabores do mundo": um botão por cozinha acende o pino dela no mapa. */
  function cozinhas(signal: AbortSignal) {
    const botoes = document.querySelectorAll<HTMLElement>("[data-cozinha]");
    const pinos = document.querySelectorAll<HTMLElement>("[data-pino]");
    botoes.forEach((b) =>
      b.addEventListener(
        "click",
        () => {
          const i = b.dataset.cozinha;
          botoes.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
          pinos.forEach((p) => p.toggleAttribute("data-ativo", p.dataset.pino === i));
        },
        { signal },
      ),
    );
  }

  function clube(signal: AbortSignal) {
    const form = document.querySelector<HTMLFormElement>("[data-clube]");
    if (!form) return;
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const erro = form.querySelector<HTMLElement>("[data-erro]")!;
    const rotulo = form.querySelector<HTMLElement>("[data-rotulo-envio]")!;

    form.addEventListener(
      "submit",
      (e) => {
        e.preventDefault();
        const ok = emailValido(email.value);
        erro.textContent = ok ? "" : "Confira o e-mail";
        erro.hidden = ok;
        if (ok) email.removeAttribute("aria-invalid");
        else email.setAttribute("aria-invalid", "true");
        // Demo: a inscrição é simulada. Num site real, ligue o formulário no
        // Formspree, Web3Forms ou no seu provedor de newsletter.
        if (ok) rotulo.textContent = "Inscrição confirmada";
      },
      { signal },
    );
  }
</script>
