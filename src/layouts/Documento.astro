---
/**
 * O documento HTML sem folha de estilo: <html>, <head>, SEO e Open Graph.
 *
 * Páginas do site usam o Base.astro, que é este layout mais o global.css.
 * Só os sites demo (src/pages/demos/<nome>/index.astro) usam este direto,
 * porque cada um traz o próprio Tailwind com tema próprio.
 */
import { ClientRouter } from "astro:transitions";

import { semIndice, site } from "../config";

export interface Props {
  /** Título da página. Vira "Título | Nome da Marca". Omita na home. */
  title?: string;
  /** Descrição para SEO. Usa a padrão do config quando omitida. */
  description?: string;
  /** Imagem de compartilhamento, dentro de `public/`. */
  ogImage?: string;
  /** Marca a página como noindex (ex.: 404). Rotas normais vão em
   *  `site.noindexPaths`, que também as tira do sitemap. */
  noindex?: boolean;
  lang?: string;
  /** Marca no título e no og:site_name. Padrão: `site.name`. Útil em demos
   *  de outro negócio hospedadas aqui. */
  marca?: string;
  /** Folha do Google Fonts. Padrão: `site.googleFonts`; `null` desliga. */
  fontes?: string | null;
  /** Cor da barra do navegador no mobile. Padrão: `site.themeColor`. */
  corTema?: string;
  /** Classes do <body>. */
  class?: string;
  /** Favicon próprio (ex.: o logo de um site demo). No lugar dos ícones do site. */
  icone?: string;
}

const {
  title,
  description = site.description,
  ogImage = site.ogImage,
  noindex = false,
  lang = site.locale,
  marca = site.name,
  fontes = site.googleFonts,
  corTema = site.themeColor,
  class: classeBody,
  icone,
} = Astro.props;

/** Rota sem barra final, para casar com `site.noindexPaths`. */
const route = Astro.url.pathname.replace(/\/$/, "") || "/";

const blockIndex = noindex || semIndice(route);

const pageTitle = title ? `${title} | ${marca}` : marca;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html class="antialiased scroll-smooth" lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={corTema} />
    <meta name="generator" content={Astro.generator} />

    {
      icone ? (
        <link rel="icon" href={icone} />
      ) : (
        <>
          <link rel="icon" href="/favicon.ico" sizes="48x48" />
          <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
          <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        </>
      )
    }
    <link rel="canonical" href={canonical} />

    {
      fontes && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fontes} />
        </>
      )
    }

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {blockIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={marca} />
    <meta property="og:locale" content={lang.replace("-", "_")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <slot name="head" />

    <ClientRouter />
  </head>
  <body class={classeBody}>
    <slot />
  </body>
</html>

<style is:global>
  html {
    /* o iOS não aumenta o texto sozinho ao girar a tela */
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
    /* 16px a partir de 400px de tela; abaixo disso encolhe junto (mínimo 12px).
       Como o Tailwind v4 mede tudo em rem, espaçamentos e textos acompanham. */
    font-size: clamp(12px, 4vw, 16px);
  }
</style>
