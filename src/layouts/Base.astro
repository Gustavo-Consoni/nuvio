---
/**
 * Layout de toda página do site: o Documento.astro (<html>, <head>, SEO)
 * mais o global.css. Props e slot `head` são os do Documento.
 */
import Documento, { type Props as PropsDocumento } from "./Documento.astro";
import "../styles/global.css";

type Props = PropsDocumento;
---

<Documento {...Astro.props}>
  <slot name="head" slot="head" />
  <slot />
</Documento>
