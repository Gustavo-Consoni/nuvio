---
/**
 * Layout das páginas demo da Blade & Co. (barbearia fictícia): catálogo de
 * cortes e página de links. Mesmo tema do site demo da barbearia
 * (styles/demos/blade-tema.css), no CSS próprio blade.css.
 *
 * Toda página daqui leva a faixa "Projeto demonstrativo": demo nunca pode
 * parecer trabalho de cliente real.
 */
import DemoSite from "./DemoSite.astro";
import { blade, fontesBlade } from "../data/demo-barbearia";
import "../styles/demos/blade.css";
import { site } from "../config";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

---

<DemoSite title={title} description={description} marca={blade.nome} fontes={fontesBlade} corTema="#0a0a0a">

  <div class="flex flex-col bg-void min-h-screen font-sans text-cream">
    <div class="flex-1">
      <slot />
    </div>

    <p class="px-4 py-8 border-white/5 border-t text-[11px] text-white/35 text-center">
      Projeto demonstrativo feito pela{" "}
      <a href="/" target="_top" class="text-gold/80 hover:text-gold underline underline-offset-2">{site.name}</a>.
      A Blade & Co. é uma barbearia fictícia.
    </p>
  </div>
</DemoSite>
