---
import { projetos } from "../../data/landing";

/** Prefixo da subpasta na prévia do GitHub Pages; "" em domínio próprio. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const comBase = (url: string) => (/^https?:\/\//.test(url) ? url : `${base}${url}`);
---

<section id="projetos" class="relative py-16 lg:py-32">
  <div class="container-page">
    <div class="mx-auto max-w-4xl text-left sm:text-center reveal">
      <span class="eyebrow">Exemplos</span>
      <h2 class="mt-4 h-section">Clique e navegue como o seu cliente</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-400 text-lg">Projetos demonstrativos: sites completos, cardápios digitais e linktrees como os que as peças abrem.</p>
    </div>

    <div class="gap-8 grid md:grid-cols-2 lg:grid-cols-3 mt-16">
      {
        projetos.map((p) => {
          const url = comBase(p.url);
          const shot = comBase(p.shot);
          return (
            <article
              data-projeto
              data-url={url}
              data-title={p.titulo}
              data-shot={shot}
              class="group bg-white/3 hover:shadow-2xl hover:shadow-brand-900/40 border border-white/8 hover:border-brand-400/40 rounded-3xl overflow-hidden transition hover:-translate-y-1 duration-300">
              <!-- sem JS é um link comum para nova aba; com JS abre no visualizador -->
              <a href={url} target="_blank" rel="noopener" data-abrir class="block relative w-full aspect-[16/10] overflow-hidden cursor-pointer">
                <img src={shot} alt={`Print do site ${p.titulo}`} loading="lazy" width="800" height="600" class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300" />
                <span class="absolute inset-0 bg-ink-950/0 group-hover:bg-ink-950/25 transition duration-300 pointer-events-none" />
                <span class="absolute inset-0 flex justify-center items-center opacity-0 group-hover:opacity-100 transition duration-300 pointer-events-none">
                  <span class="bg-white/95 px-4 py-2 rounded-full font-bold text-ink-950 text-sm">Ver o site</span>
                </span>
                <span class="top-4 left-4 absolute bg-ink-950/70 backdrop-blur px-4 py-1 rounded-full font-semibold text-[11px] text-slate-200 uppercase tracking-wider">{p.categoria}</span>
              </a>
              <div class="p-8">
                <h3 class="font-display font-bold text-white text-lg">{p.titulo}</h3>
                <p class="mt-2 text-slate-400 text-sm">{p.descricao}</p>
                <div class="flex justify-between items-center mt-4 pt-4 border-white/8 border-t">
                  <span class:list={["font-semibold text-sm", p.resultado.destaque ? "text-emerald-400" : "text-amber-400"]}>{p.resultado.texto}</span>
                  <span class="text-slate-500 text-xs">{p.resultado.detalhe}</span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
