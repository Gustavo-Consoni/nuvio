---
import MockupPecas from "./MockupPecas.astro";
import Seta from "../icons/Seta.astro";
import { hero } from "../../data/landing";
---

<section id="hero" class="relative pt-32 pb-16 lg:pb-32 overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-70 pointer-events-none mask-fade-b"></div>
  <div class="-top-40 left-1/2 absolute bg-brand-600/25 blur-[140px] rounded-full w-[900px] h-[540px] -translate-x-1/2 pointer-events-none"></div>
  <div class="right-0 -bottom-32 absolute bg-accent-500/15 blur-[130px] rounded-full w-[420px] h-[420px] pointer-events-none"></div>

  <div class="relative container-page">
    <div class="items-center gap-16 grid lg:grid-cols-[1.05fr_.95fr]">
      <div class="max-w-2xl">
        <span class="eyebrow">
          <span class="relative flex w-2 h-2">
            <span class="inline-flex absolute bg-brand-400 opacity-75 rounded-full w-full h-full animate-ping"></span>
            <span class="inline-flex relative bg-brand-400 rounded-full w-2 h-2"></span>
          </span>
          {hero.selo}
        </span>

        <h1 class="mt-8 font-display font-extrabold text-white text-4xl sm:text-5xl lg:text-6xl leading-[1.08] tracking-tight">
          {hero.titulo.antes}{" "}
          <span class="text-gradient">{hero.titulo.destaque}</span>{hero.titulo.depois}
        </h1>

        <p class="mt-8 text-slate-400 text-lg leading-relaxed">
          {hero.texto}
        </p>

        <div class="flex sm:flex-row flex-col gap-4 mt-8">
          <a href="#teste" class="btn-primary btn-lg">
            Ver funcionando
            <Seta />
          </a>
        </div>
      </div>

      <MockupPecas />
    </div>
  </div>
</section>
