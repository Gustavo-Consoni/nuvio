---
import WhatsApp from "../icons/WhatsApp.astro";
import { site } from "../../config";

const whatsapp = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(site.contact.whatsappMessage)}`;
---

<a
  href={whatsapp}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
  class="group bottom-6 left-6 z-40 fixed flex items-center gap-4 bg-emerald-500 hover:bg-emerald-400 shadow-2xl shadow-emerald-500/30 hover:shadow-emerald-400/40 py-4 pr-4 pl-4 rounded-full font-semibold text-white transition duration-300">
  <WhatsApp class="w-6 h-6" />
  <span class="hidden sm:inline text-sm">Falar no WhatsApp</span>
</a>

<!-- aparece junto com o fundo do header: o script do Header.astro liga o
     `data-rolou` nos dois e tira o `inert` deste -->
<a
  href="#hero"
  data-topo
  inert
  aria-label="Voltar ao topo"
  class="right-6 bottom-6 z-40 fixed place-items-center grid bg-ink-850/90 hover:bg-ink-800 opacity-0 data-rolou:opacity-100 shadow-xl backdrop-blur border border-white/10 hover:border-brand-400/50 rounded-full w-12 h-12 text-white transition duration-300 pointer-events-none data-rolou:pointer-events-auto">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path></svg>
</a>
