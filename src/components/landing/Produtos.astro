---
import Check from "../icons/Check.astro";
import { produtos, reais } from "../../data/landing";
---

<section id="produtos" class="relative py-16 lg:py-32 overflow-hidden">
  <div class="top-1/3 left-1/2 absolute bg-brand-700/12 blur-[150px] rounded-full w-[760px] h-[380px] -translate-x-1/2 pointer-events-none"></div>

  <div class="relative container-page">
    <div class="mx-auto max-w-4xl text-left sm:text-center reveal">
      <span class="eyebrow">Produtos</span>
      <h2 class="mt-4 h-section">Cinco peças, cada uma num lugar</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-400 text-lg">Leve só o que falta, ou junte as peças que fazem sentido para o seu negócio.</p>
    </div>

    <div class="gap-4 grid sm:grid-cols-2 lg:grid-cols-6 mt-16">
      {
        produtos.map((p, i) => (
          <article
            class:list={["group flex flex-col card card-hover reveal", i < 3 ? "lg:col-span-2" : "lg:col-span-3"]}
            data-atraso={(i % 3) * 90}>
            <div class="flex justify-between items-start gap-4">
              <span class="place-items-center grid bg-gradient-to-br from-brand-500/20 to-accent-500/15 rounded-2xl ring-1 ring-white/10 w-12 h-12 text-2xl group-hover:scale-110 transition duration-300">
                {p.icone}
              </span>
              <span class="bg-white/5 px-4 py-1 border border-white/10 rounded-full font-semibold text-[11px] text-slate-300">{p.onde}</span>
            </div>
            <h3 class="mt-4 font-display font-bold text-white text-lg">{p.nome}</h3>
            <p class="mt-2 text-slate-400 text-sm leading-relaxed">{p.texto}</p>
            <ul class="space-y-2 mt-4">
              {p.itens.map((item) => (
                <li class="flex items-start gap-2 text-slate-400 text-sm">
                  <Check />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              <div class="pt-4 border-white/8 border-t">
                <p class="text-slate-400 text-sm">
                  <span class="font-display font-extrabold text-white text-2xl">R$ {reais(p.preco)}</span>
                  {p.unidade && <span> {p.unidade}</span>}
                </p>
                {p.extra && <p class="mt-1 text-slate-500 text-xs">{p.extra}</p>}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
