---
import Logo from "./Logo.astro";
import Seta from "../icons/Seta.astro";

interface Props {
  links: { id: string; label: string }[];
}
const { links } = Astro.props;
---

<!-- `data-rolou` é ligado pelo script quando a página desce 40px -->
<header
  data-header
  class="top-0 z-50 fixed inset-x-0 py-4 transition-all duration-300 data-rolou:border-b data-rolou:border-white/10 data-rolou:bg-ink-950/80 data-rolou:backdrop-blur-xl data-rolou:py-4">
  <div class="flex justify-between items-center gap-8 container-page">
    <Logo />

    <nav class="hidden xl:flex items-center gap-8">
      {links.map((l) => <a href={`#${l.id}`} class="whitespace-nowrap link-nav">{l.label}</a>)}
    </nav>

    <div class="hidden xl:flex items-center gap-4">
      <a href="#contato" class="btn-primary">
        Fale com a gente
        <Seta />
      </a>
    </div>

    <button
      type="button"
      data-menu-botao
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
      class="group xl:hidden place-items-center grid bg-white/5 border border-white/10 rounded-xl w-11 h-11 text-white cursor-pointer">
      <svg class="group-aria-expanded:hidden w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="hidden group-aria-expanded:block w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>

  <!-- Sem JavaScript o menu fica aberto; com ele, fecha e anima pela altura
       (ver .menu-mobile no global.css) -->
  <div id="menu-mobile" data-menu class="xl:hidden menu-mobile">
    <div class="min-h-0 overflow-hidden">
      <div class="space-y-1 bg-ink-900/95 backdrop-blur-xl mt-4 p-4 border border-white/10 rounded-3xl container-page">
        {
          links.map((l) => (
            <a href={`#${l.id}`} class="block hover:bg-white/5 px-4 py-4 rounded-2xl font-medium text-slate-300 hover:text-white text-sm">
              {l.label}
            </a>
          ))
        }
        <a href="#contato" class="mt-4 w-full btn-primary">Fale com a gente</a>
      </div>
    </div>
  </div>
</header>

<script>
  import { aCadaPagina } from "../../scripts/pagina";

  aCadaPagina((signal) => {
    const header = document.querySelector<HTMLElement>("[data-header]");
    const botao = document.querySelector<HTMLButtonElement>("[data-menu-botao]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    if (!header || !botao || !menu) return;

    const abrir = (aberto: boolean) => {
      botao.setAttribute("aria-expanded", String(aberto));
      botao.setAttribute("aria-label", aberto ? "Fechar menu" : "Abrir menu");
      menu.toggleAttribute("data-aberto", aberto);
      // fechado ele só encolhe: `inert` tira os links do Tab e do leitor de tela
      menu.inert = !aberto;
    };
    abrir(false);

    botao.addEventListener("click", () => abrir(botao.getAttribute("aria-expanded") !== "true"), { signal });
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => abrir(false), { signal }));
    window.addEventListener("resize", () => window.innerWidth >= 1280 && abrir(false), { signal });

    // O botão de voltar ao topo (Flutuantes.astro) segue o mesmo estado.
    const rolaveis = document.querySelectorAll<HTMLElement>("[data-header], [data-topo]");
    const aoRolar = () => {
      const rolou = window.scrollY > 40;
      rolaveis.forEach((el) => {
        el.toggleAttribute("data-rolou", rolou);
        if (el.matches("[data-topo]")) el.inert = !rolou;
      });
    };
    aoRolar();
    window.addEventListener("scroll", aoRolar, { passive: true, signal });
  });
</script>
