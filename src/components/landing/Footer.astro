---
import Logo from "./Logo.astro";
import Rede from "../icons/Rede.astro";
import { site } from "../../config";

interface Props {
  links: { id: string; label: string }[];
}
const { links } = Astro.props;
---

<footer class="bg-ink-950 pt-16 pb-8 border-white/8 border-t">
  <div class="container-page">
    <div class="gap-16 md:gap-8 lg:gap-16 grid sm:grid-cols-2 md:grid-cols-4">
      <div class="sm:col-span-2 min-w-0">
        <Logo />
        <p class="mt-4 max-w-sm text-slate-400 text-sm leading-relaxed">
          Colocamos pequenos negócios no celular do cliente: Google Meu Negócio, sites, linktrees, plaquinhas e cartões de aproximação com a cara de cada um. Sem mensalidade.
        </p>
        <div class="flex gap-4 mt-8">
          {
            site.socials.map((s) => (
              <a href={s.href} aria-label={s.name} target="_blank" rel="noopener" class="place-items-center grid bg-white/4 hover:bg-white/8 border border-white/10 hover:border-brand-400/40 rounded-xl w-10 h-10 text-slate-400 hover:text-white transition duration-300">
                <Rede nome={s.name} />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h4 class="font-display font-bold text-white text-sm uppercase tracking-widest">Navegação</h4>
        <ul class="space-y-4 mt-4 text-sm">
          {links.map((l) => <li><a href={`#${l.id}`} class="text-slate-400 hover:text-brand-400 transition duration-300">{l.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="font-display font-bold text-white text-sm uppercase tracking-widest">Contato</h4>
        <ul class="space-y-4 mt-4 text-slate-400 text-sm break-words">
          <li>{site.contact.email}</li>
          <li>{site.contact.phoneDisplay}</li>
        </ul>
      </div>
    </div>

    <div class="flex sm:flex-row flex-col justify-between items-center gap-4 mt-16 pt-8 border-white/8 border-t text-slate-500 text-xs">
      <p>© <span data-ano>{new Date().getFullYear()}</span> {site.name}. Todos os direitos reservados.</p>
      <div class="flex gap-8">
        <a href="#" class="hover:text-slate-300 transition duration-300">Política de privacidade</a>
        <a href="#" class="hover:text-slate-300 transition duration-300">Termos de uso</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import { aCadaPagina } from "../../scripts/pagina";

  // O ano sai do build; isto só corrige se o site passar da virada sem rebuild.
  aCadaPagina(() => {
    document.querySelectorAll("[data-ano]").forEach((el) => (el.textContent = String(new Date().getFullYear())));
  });
</script>
