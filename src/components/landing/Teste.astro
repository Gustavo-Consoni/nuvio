---
/**
 * "Teste agora": o visitante escolhe uma peça, "encosta" o celular e vê no
 * celular desenhado a mesma sequência do cliente real: notificação, toque,
 * página aberta (cardápio, avaliação ou linktree).
 *
 * Estado em `data-estado` na raiz: parado → encostando → notificando →
 * aberto. O visual de cada estado sai de variantes `group-data-[estado=...]`.
 * Sem JavaScript a seção mostra a tela parada.
 */
import Plaquinha from "./Plaquinha.astro";
import { teste } from "../../data/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const comBase = (tela: string) => (tela.startsWith("/") ? `${base}${tela}` : null);

const ondas = "M8.5 8.5a5 5 0 0 1 0 7M12 5.5a9.5 9.5 0 0 1 0 13M15.5 2.5a14 14 0 0 1 0 19";
const primeira = teste[0];
---

<section id="teste" class="relative py-16 lg:py-32 overflow-hidden">
  <div class="top-1/2 right-0 absolute bg-accent-500/10 blur-[150px] rounded-full w-[620px] h-[420px] -translate-y-1/2 pointer-events-none"></div>

  <div data-teste data-estado="parado" data-peca={primeira.id} class="group relative items-center gap-16 grid lg:grid-cols-2 container-page">
    <div class="reveal">
      <span class="eyebrow">Teste agora</span>
      <h2 class="mt-4 h-section">Encoste o celular e veja a experiência do cliente</h2>
      <p class="mt-4 text-slate-400 text-lg">
        Escolha uma peça e toque em "Encostar o celular". É exatamente isso que acontece no seu balcão.
      </p>

      <div class="space-y-4 mt-8" role="group" aria-label="Escolha a peça">
        {
          teste.map((t, i) => (
            <button
              type="button"
              data-escolher={t.id}
              data-tela={t.tela}
              data-notificacao={t.notificacao}
              data-link={comBase(t.tela) ?? ""}
              aria-pressed={i === 0 ? "true" : "false"}
              class="group/escolha flex justify-between items-center gap-4 bg-white/3 aria-pressed:bg-brand-500/10 px-4 py-4 border border-white/8 aria-pressed:border-brand-400/60 hover:border-white/20 rounded-2xl w-full text-left transition duration-300 cursor-pointer">
              <span>
                <span class="block font-display font-bold text-white">{t.peca}</span>
                <span class="block mt-0.5 text-slate-400 text-sm">Abre: {t.abre}</span>
              </span>
              <span class="place-items-center grid border-2 border-white/20 rounded-full w-5 h-5 shrink-0" aria-hidden="true">
                <span class="bg-brand-400 opacity-0 group-aria-pressed/escolha:opacity-100 rounded-full w-2.5 h-2.5" />
              </span>
            </button>
          ))
        }
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-4 mt-8">
        <button type="button" data-encostar class="cursor-pointer btn-primary btn-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d={ondas} /></svg>
          Encostar o celular
        </button>
      </div>
    </div>

    <!-- palco: a peça escolhida e o celular -->
    <div data-palco class="relative mx-auto w-full max-w-md h-[540px]" aria-live="polite">
      <!-- peça: "encosta" no celular e fica lá enquanto a notificação aparece -->
      <div class="bottom-10 left-0 z-20 absolute transition-transform group-data-[estado=encostando]:translate-x-[45%] group-data-[estado=notificando]:translate-x-[45%] group-data-[estado=encostando]:-translate-y-[60%] group-data-[estado=notificando]:-translate-y-[60%] duration-700 ease-[cubic-bezier(.16,1,.3,1)] pointer-events-none" aria-hidden="true">
        <Plaquinha class="hidden group-data-[peca=caixa]:block w-40 rotate-6" />
        <div class="group-data-[peca=caixa]:hidden bg-gradient-to-br from-blade-gold to-[#8f7a5a] shadow-2xl shadow-black/50 p-4 border border-white/20 rounded-xl w-48 aspect-[1.586] -rotate-6">
          <div class="flex justify-between items-start">
            <span class="font-display font-extrabold text-blade-void text-sm tracking-[0.2em]">BLADE & CO.</span>
            <svg class="w-6 h-6 text-blade-void/70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d={ondas} /></svg>
          </div>
          <p class="bottom-4 left-4 absolute font-semibold text-[9px] text-blade-void/70 uppercase tracking-widest">
            <span class="group-data-[peca=bio]:hidden">Cortes e preços</span>
            <span class="hidden group-data-[peca=bio]:inline">Nossos links</span>
          </p>
        </div>
      </div>

      <!-- celular -->
      <div class="top-0 right-0 absolute bg-ink-900 shadow-2xl shadow-black/60 p-2 border border-white/15 rounded-[2.5rem] w-[62%] sm:w-[270px] h-full">
        <div data-tela-celular class="relative bg-gradient-to-b from-ink-800 to-ink-950 rounded-[2rem] w-full h-full overflow-hidden">
          <div class="top-2 left-1/2 z-30 absolute bg-black rounded-full w-20 h-5 -translate-x-1/2"></div>

          <!-- tela bloqueada -->
          <div class="flex flex-col items-center pt-16 h-full text-center">
            <p class="font-display font-bold text-white/90 text-5xl">9:41</p>
            <p class="mt-1 text-slate-400 text-xs">quinta-feira</p>
            <p class="group-data-[estado=aberto]:hidden mt-auto mb-8 px-8 text-slate-500 text-xs">
              <span class="group-data-[estado=parado]:inline hidden">Escolha uma peça e encoste o celular</span>
              <span class="group-data-[estado=notificando]:inline hidden">Toque na notificação</span>
            </p>
          </div>

          <!-- notificação -->
          <button
            type="button"
            data-abrir-notificacao
            class="top-10 right-2.5 left-2.5 z-20 absolute bg-white/15 opacity-0 group-data-[estado=notificando]:opacity-100 shadow-xl backdrop-blur-xl p-4 border border-white/15 rounded-2xl text-left transition-all -translate-y-4 group-data-[estado=notificando]:translate-y-0 duration-300 cursor-pointer pointer-events-none group-data-[estado=notificando]:pointer-events-auto"
            tabindex="-1">
            <span class="flex items-center gap-2">
              <span class="place-items-center grid bg-accent-500 rounded-lg w-8 h-8 text-white shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d={ondas} /></svg>
              </span>
              <span class="min-w-0">
                <span class="block font-semibold text-[11px] text-white">Blade & Co.</span>
                <span data-texto-notificacao class="block text-[11px] text-slate-300 truncate">{primeira.notificacao}</span>
              </span>
            </span>
          </button>

          <!-- app aberto: iframe da demo (criado pelo script) ou a avaliação do Google -->
          <div data-app class="z-10 absolute inset-0 bg-white opacity-0 group-data-[estado=aberto]:opacity-100 transition-opacity duration-300 pointer-events-none group-data-[estado=aberto]:pointer-events-auto">
            <div data-google hidden class="flex flex-col px-4 pt-16 h-full font-sans text-slate-800">
              <p class="text-[10px] text-slate-500">Simulação da tela do Google</p>
              <p class="mt-4 font-semibold text-base">Blade & Co.</p>
              <p class="text-slate-500 text-xs">Postando publicamente</p>
              <div class="flex justify-center gap-2 mt-8" role="group" aria-label="Nota">
                {
                  [1, 2, 3, 4, 5].map((n) => (
                    <button type="button" data-estrela={n} aria-label={`${n} estrelas`} class="text-slate-300 data-cheia:text-amber-400 text-3xl transition duration-300 cursor-pointer">
                      ★
                    </button>
                  ))
                }
              </div>
              <div class="mt-8 p-4 border border-slate-300 rounded-lg h-24 text-slate-400 text-xs">Compartilhe detalhes da sua experiência</div>
              <button type="button" data-postar class="self-end bg-blue-600 hover:bg-blue-700 mt-4 px-4 py-2 rounded-full font-semibold text-white text-xs transition duration-300 cursor-pointer">Postar</button>
              <p data-postado hidden class="mt-4 font-semibold text-emerald-600 text-xs text-center">Avaliação enviada! Simples assim.</p>
            </div>
          </div>

          <!-- voltar -->
          <button type="button" data-voltar class="bottom-3 left-1/2 z-30 absolute bg-ink-950/80 opacity-0 group-data-[estado=aberto]:opacity-100 backdrop-blur px-4 py-2 rounded-full font-semibold text-[11px] text-white whitespace-nowrap transition-opacity -translate-x-1/2 duration-300 cursor-pointer pointer-events-none group-data-[estado=aberto]:pointer-events-auto">
            Testar de novo
          </button>
        </div>
      </div>

      <!-- ondas no ponto de contato -->
      <span class="hidden group-data-[estado=notificando]:block top-[45%] right-[42%] absolute border-2 border-accent-400/60 rounded-full w-16 h-16 animate-ping pointer-events-none"></span>
    </div>
  </div>
</section>

<script>
  import { aCadaPagina } from "../../scripts/pagina";

  /** Largura em que as demos são desenhadas antes de encolher na tela do celular. */
  const LARGURA_DEMO = 390;

  aCadaPagina((signal) => {
    const raiz = document.querySelector<HTMLElement>("[data-teste]");
    if (!raiz) return;
    const tela = raiz.querySelector<HTMLElement>("[data-tela-celular]")!;
    const app = raiz.querySelector<HTMLElement>("[data-app]")!;
    const google = raiz.querySelector<HTMLElement>("[data-google]")!;
    const notificacao = raiz.querySelector<HTMLButtonElement>("[data-abrir-notificacao]")!;
    const textoNotificacao = raiz.querySelector<HTMLElement>("[data-texto-notificacao]")!;
    const escolhas = [...raiz.querySelectorAll<HTMLButtonElement>("[data-escolher]")];
    const estrelas = [...raiz.querySelectorAll<HTMLElement>("[data-estrela]")];
    const postado = raiz.querySelector<HTMLElement>("[data-postado]")!;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const escolhida = () => escolhas.find((b) => b.getAttribute("aria-pressed") === "true")!;
    const estado = (e: string) => (raiz.dataset.estado = e);

    const reiniciar = () => {
      clearTimeout(timer);
      estado("parado");
      app.querySelector("iframe")?.remove();
      google.hidden = true;
      postado.hidden = true;
      estrelas.forEach((s) => s.removeAttribute("data-cheia"));
      notificacao.tabIndex = -1;
    };

    escolhas.forEach((botao) =>
      botao.addEventListener(
        "click",
        () => {
          escolhas.forEach((b) => b.setAttribute("aria-pressed", String(b === botao)));
          raiz.dataset.peca = botao.dataset.escolher;
          textoNotificacao.textContent = botao.dataset.notificacao ?? "";
          reiniciar();
        },
        { signal },
      ),
    );

    raiz.querySelector("[data-encostar]")?.addEventListener(
      "click",
      () => {
        reiniciar();
        // No celular o palco fica abaixo do botão, e no desktop o topo dele
        // pode estar atrás do header fixo: traz o celular inteiro para a tela.
        const palco = raiz.querySelector<HTMLElement>("[data-palco]")!;
        const r = palco.getBoundingClientRect();
        const header = document.querySelector("[data-header]")?.getBoundingClientRect().bottom ?? 0;
        if (r.top < header || r.bottom > window.innerHeight) palco.scrollIntoView({ behavior: "smooth", block: "center" });
        estado("encostando");
        timer = setTimeout(() => {
          estado("notificando");
          notificacao.tabIndex = 0;
          notificacao.focus({ preventScroll: true });
        }, 750);
      },
      { signal },
    );

    notificacao.addEventListener(
      "click",
      () => {
        const botao = escolhida();
        if (botao.dataset.tela === "google") {
          google.hidden = false;
        } else {
          // a demo é desenhada em 390px e encolhida para caber na tela
          const escala = tela.clientWidth / LARGURA_DEMO;
          const iframe = document.createElement("iframe");
          iframe.src = botao.dataset.link ?? "";
          iframe.title = botao.textContent?.trim() ?? "Demonstração";
          iframe.className = "absolute top-0 left-0 border-0 origin-top-left";
          iframe.style.width = `${LARGURA_DEMO}px`;
          iframe.style.height = `${tela.clientHeight / escala}px`;
          iframe.style.transform = `scale(${escala})`;
          app.append(iframe);
        }
        notificacao.tabIndex = -1;
        estado("aberto");
      },
      { signal },
    );

    raiz.querySelector("[data-voltar]")?.addEventListener("click", reiniciar, { signal });

    estrelas.forEach((estrela) =>
      estrela.addEventListener(
        "click",
        () => {
          const n = Number(estrela.dataset.estrela);
          estrelas.forEach((s) => s.toggleAttribute("data-cheia", Number(s.dataset.estrela) <= n));
        },
        { signal },
      ),
    );
    raiz.querySelector("[data-postar]")?.addEventListener("click", () => (postado.hidden = false), { signal });

    signal.addEventListener("abort", () => clearTimeout(timer));
  });
</script>
