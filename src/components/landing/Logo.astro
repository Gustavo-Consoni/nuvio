---
interface Props {
  /** Nome ao lado do selo. */
  nome?: string;
  href?: string;
}
const { nome = "Nuvio", href = "#hero" } = Astro.props;
---

<a href={href} class="flex items-center gap-2">
  <!-- alt vazio: o nome ao lado já dá o texto do link -->
  <img src="/images/logo.webp" alt="" width="36" height="36" class="rounded-xl w-9 h-9" />
  <span class="font-display font-extrabold text-white text-lg tracking-tight">{nome}</span>
</a>
