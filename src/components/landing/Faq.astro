---
import { faq } from "../../data/landing";
---

<section id="faq" class="relative py-16 lg:py-32">
  <div class="container-page">
    <div class="gap-16 grid lg:grid-cols-[.85fr_1.15fr]">
      <div class="lg:top-32 lg:sticky lg:self-start">
        <span class="eyebrow">FAQ</span>
        <h2 class="mt-4 h-section">Perguntas que sempre aparecem</h2>
        <p class="mt-4 text-slate-400">Não achou a sua? Chama no WhatsApp que a gente responde rápido.</p>
        <a href="#contato" class="mt-8 btn-ghost">Tirar uma dúvida</a>
      </div>

      <!-- Acordeão sem JavaScript: <details> com o mesmo `name` abre um de
           cada vez. A animação de altura está em .faq no global.css. -->
      <div class="space-y-4">
        {
          faq.map((item, i) => (
            <details
              name="faq"
              open={i === 0}
              class="group bg-white/3 open:bg-white/6 border border-white/8 open:border-brand-400/40 not-open:hover:border-white/20 rounded-2xl overflow-hidden transition duration-300 faq">
              <summary class="flex justify-between items-center gap-4 px-8 py-4 w-full text-left cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <span class="font-display font-semibold text-white">{item.pergunta}</span>
                <svg class="w-5 h-5 text-brand-400 group-open:rotate-45 transition-transform duration-300 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
              </summary>
              <p class="px-8 pb-4 text-slate-400 text-sm leading-relaxed">{item.resposta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
